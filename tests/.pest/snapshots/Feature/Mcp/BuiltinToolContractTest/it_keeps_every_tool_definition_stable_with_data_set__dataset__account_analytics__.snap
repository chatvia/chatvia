                "start_date": {
                    "description": "Optional explicit start date (YYYY-MM-DD). When given together with end_date it overrides `period`.",
                    "type": "string"
                },
                "end_date": {
                    "description": "Optional explicit end date (YYYY-MM-DD).",
                    "type": "string"
                },
                "agent": {
                    "description": "Optional agent id to narrow the numbers to a single agent. Omit for the whole account (all agents).",
                    "type": "string"
                }
            },
            "type": "object"
        },
        "annotations": {
            "readOnlyHint": true,
            "idempotentHint": true
        }
    },
    {
        "name": "get-token-usage-tool",
        "title": "Get Token Usage Tool",
        "description": "Token consumption for a period: total tokens used, the prompt vs completion\nsplit, the average tokens per AI reply, and a per-day series. Answers \"how many\ntokens did I consume this month?\", \"what's my prompt vs completion split?\".\nTokens are reported for analytics only; message limits count replies, not\ntokens.",
        "inputSchema": {
            "properties": {
                "period": {
                    "description": "Time window. Defaults to \"this_month\". Use \"last_month\" for the one before, or a rolling window like \"last_7_days\"/\"last_30_days\".",
                    "default": "this_month",
                    "enum": [
                        "this_month",
                        "today",
