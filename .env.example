APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# Postgres TLS: 'prefer' (default) allows plaintext fallback. Set to 'require'
# (or 'verify-full' with the Scaleway CA) in production so app→DB can't downgrade.
# DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Encrypt session payloads at rest. Defaults to true; only disable for debugging.
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

#-------------------------------------------------------------------------------
# Security — set these explicitly in every non-local environment.
#-------------------------------------------------------------------------------

# Stripe webhook signing secret. REQUIRED in production: when empty, Cashier
# silently skips signature verification and /stripe/webhook accepts forged
# events (the app refuses to boot in production without it).
STRIPE_WEBHOOK_SECRET=

# Shared HMAC secrets for the server-to-server ingestion + built-in MCP
# callbacks. They fall back to APP_KEY when unset, but set them explicitly so
# the trust boundary is auditable.
INGESTION_WEBHOOK_SECRET=
BUILTIN_MCP_SECRET=

# Comma-separated upstream proxy IPs/CIDRs (e.g. Cloudflare ranges). Leave empty
# ONLY when no proxy sits in front. Behind a proxy/CDN this MUST be set, or all
# per-IP rate limiting collapses onto the single edge IP. '*' is honoured only
# when APP_ENV=local.
TRUSTED_PROXIES=

# Pin the session cookie hardening explicitly rather than relying on framework
# auto-detection. Use `true` over HTTPS in production. Never set SameSite to
# `none` for the session cookie — it disables the cross-site CSRF protection the
# CSRF-exempt /chat/* routes rely on.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Public-API token lifetime (minutes). Defaults to 1 year so issued tokens are
# not immortal; lower it to tighten the exposure window of a leaked token.
SANCTUM_TOKEN_TTL_MINUTES=525600

# Per-agent ceilings for the LLM-cost widget stream (defence against anonymous
# financial DoS on public agents). Tune to plan size.
WIDGET_STREAM_PER_AGENT_PER_MINUTE=120
WIDGET_STREAM_PER_AGENT_PER_HOUR=1500

#-------------------------------------------------------------------------------
# Meta (Facebook) — Messenger today, Instagram/WhatsApp later, via ONE Chatvia app.
#-------------------------------------------------------------------------------
# Chatvia's own Facebook app. Customers connect their Pages through Facebook
# Login for Business (OAuth) instead of creating their own app. App id + secret
# come from the app's App settings → Basic.
META_APP_ID=
META_APP_SECRET=
# Facebook Login for Business configuration id (Use cases → Customize → Facebook
# Login for Business → Configurations). Optional — leave empty to request the
# scopes classically.
META_LOGIN_CONFIG_ID=
# Separate Login-for-Business configuration for Instagram (Instagram permissions).
# Optional — leave empty to reuse META_LOGIN_CONFIG_ID.
META_INSTAGRAM_LOGIN_CONFIG_ID=
META_GRAPH_VERSION=v25.0
# OAuth redirects — each must be whitelisted in the app's Login settings and match
# these routes exactly.
# https://<your-app-url>/my/channels/messenger/oauth/callback
META_REDIRECT_URI=
# https://<your-app-url>/my/channels/instagram/oauth/callback
META_INSTAGRAM_REDIRECT_URI=
# Single app-level webhook verify token (any random string) — paste the same
# value into the app's Messenger → Webhooks settings.
META_WEBHOOK_VERIFY_TOKEN=
