{
    "requests": [
        {
            "method": "POST",
            "url": "https://perplexity.example.test/chat/completions",
            "authorization": "Bearer pplx-key",
            "body": {
                "model": "sonar-pro",
                "messages": [
                    {
                        "role": "system",
                        "content": "Answer the question thoroughly and accurately using live web sources. Explain the key reasoning and cite every factual claim."
                    },
                    {
                        "role": "user",
                        "content": "why is the sky blue"
                    }
                ]
            }
        }
    ],
    "result": {
        "content": [
            {
                "type": "text",
                "text": "The answer is 42.\n\nSources:\n[1] Guide — https://example.com/guide\n[2] https://example.com/untitled — https://example.com/untitled\n"
            }
        ],
        "isError": false,
        "structuredContent": {
            "answer": "The answer is 42.",
            "citations": [
                {
                    "title": "Guide",
                    "url": "https://example.com/guide"
                },
                {
                    "title": "",
                    "url": "https://example.com/untitled"
                }
            ]
        }
    }
}