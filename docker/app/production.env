#===============================================================================
# Chatvia Docker image: production defaults (copied to /var/www/chatvia/.env).
#
# No secrets here. APP_KEY, DB_PASSWORD, REVERB_APP_* and BUILTIN_MCP_SECRET
# are created per install by chatvia-setup, so no two installs share them.
#
# Every value can be changed with an environment variable: a real environment
# variable always wins over this file. The host names (postgres, redis,
# reverb, app, chunker) are the service names in docker/compose.yaml.
#
# API keys of outside services (AI providers, Firecrawl, mail, social
# sign-in, channels) are not set here: enter them in the admin panel, under
# Settings (/admin/settings).
#===============================================================================

APP_NAME=Chatvia
APP_ENV=production
APP_DEBUG=false
# The address people use to open the app, without a trailing slash. Set it
# when you publish another port or put the app behind a domain.
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Logs go to the container output (docker compose logs).
LOG_CHANNEL=stderr
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=chatvia
DB_USERNAME=chatvia

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database
SESSION_ENCRYPT=true

# "log" writes every e-mail to the container output. Set an SMTP server
# (MAIL_MAILER=smtp, MAIL_HOST, MAIL_PORT, MAIL_USERNAME, MAIL_PASSWORD)
# before other people use the app: sign-up, invitations and password resets
# are sent by e-mail.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

# The app sends events to Reverb inside the Docker network. Browsers connect
# through the web container (/app/ is forwarded to Reverb).
BROADCAST_CONNECTION=reverb
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

FILESYSTEM_DISK=local

# The app calls its own built-in tools (/mcp/...) on the web container
# instead of APP_URL, which may not be reachable from inside a container.
BUILTIN_MCP_INTERNAL_URL=http://app:8080

# Text is split into chunks by the chunker service of this stack
# (github.com/chatvia/chunker). It takes no API key: a chunk.fit key saved in
# the admin panel is only sent to the hosted chunk.fit, never to this one.
AI_TEXT_SPLITTER=chunkfit
CHUNK_FIT_BASE_URL=http://chunker:8000/api/v1

CSP_MODE=report-only
