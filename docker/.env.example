#===============================================================================
# Settings for docker/compose.yaml. Copy this file to .env (next to
# compose.yaml) and remove the "#" in front of the lines you want to change.
# Without a .env file the defaults below are used.
#===============================================================================

#-------------------------------------------------------------------------------
# Image
#-------------------------------------------------------------------------------
# The release to run, like 1.4.0. The installer writes the exact version here,
# and ./manage upgrade changes it. "latest" (the default without a .env) is
# the newest release; a real server should name one, so an upgrade only
# happens when you change it.
# CHATVIA_VERSION=latest
# CHATVIA_IMAGE=ghcr.io/chatvia/chatvia

#-------------------------------------------------------------------------------
# Address
#-------------------------------------------------------------------------------
# The port on this machine that serves the app. The app listens on port 8080
# inside its container.
# APP_PORT=8000

# The address people use to open the app, without a trailing slash. Change
# it together with APP_PORT, or set your domain when a proxy with HTTPS is in
# front (then also set SESSION_SECURE_COOKIE=true, APP_BIND_IP and
# TRUSTED_PROXIES; the installer does when you choose your own proxy).
# APP_URL=http://localhost:8000
# SESSION_SECURE_COOKIE=true

# Where the port listens: 127.0.0.1 keeps it to this machine, for a proxy
# that runs here. Empty means every network (a proxy on another machine).
# APP_BIND_IP=127.0.0.1

# The proxies in front, comma-separated IPs or ranges. A proxy on this
# machine reaches the app from Docker's own networks, which the ranges below
# cover. A proxy on another machine: its address instead. The word
# "cloudflare" stands for Cloudflare's published ranges: add it when your
# domain is behind Cloudflare, or visitor IPs, countries and rate limits see
# Cloudflare's edge instead of the visitor (for example "cloudflare,172.16.0.0/12").
# TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

#-------------------------------------------------------------------------------
# First start only
#-------------------------------------------------------------------------------
# Read on the very first start, when the database is created. Changing them
# later has no effect on the existing database. An empty password is replaced
# by a random one.
# DB_DATABASE=chatvia
# DB_USERNAME=chatvia
# DB_PASSWORD=

# The first admin account. Without ADMIN_PASSWORD a random password is made
# and printed once: `docker compose logs migrate`. Remove the password from
# this file after the first start.
# ADMIN_EMAIL=admin@example.com
# ADMIN_NAME=Admin
# ADMIN_PASSWORD=

# How the database stores embeddings (the search vectors of your knowledge).
# Read when the database is created; after that they must stay the same, or
# the stack stops with an error in `docker compose logs migrate`.
# halfvec uses half the space of vector with almost the same search quality.
# 1024 dimensions work with every embedding provider.
# EMBEDDING_VECTOR_TYPE=halfvec
# EMBEDDING_DIMENSIONS=1024

# What the search index holds: binary (about 6x smaller, almost the same
# results) or full. This one may change: the next start rebuilds the index.
# EMBEDDING_INDEX=binary

# Your own app key instead of a random one (from `php artisan key:generate
# --show`). Keep it: encrypted data, like the API keys in the admin panel,
# cannot be read without it. To change it later, put the old key in
# APP_PREVIOUS_KEYS.
# APP_KEY=
# APP_PREVIOUS_KEYS=

#-------------------------------------------------------------------------------
# Web workers
#-------------------------------------------------------------------------------
# How many requests the app container answers at once. Pages and API calls
# have their own workers, and chat answers have theirs, so a busy chat never
# makes pages wait. A chat answer keeps its worker until it ends. Each worker
# uses up to about 80 MB of memory and one database connection while busy;
# PostgreSQL allows 100 connections unless you raise max_connections. Apply
# a change with ./manage restart app.
# PHP_FPM_PM_MAX_CHILDREN=16
# CHATVIA_STREAM_WORKERS=32

#-------------------------------------------------------------------------------
# Anything else
#-------------------------------------------------------------------------------
# Email, API keys, the AI services, your brand and the other options are not
# set here: enter them in the admin panel, under Settings. Until email is set
# up there, e-mails are only written to the logs.
