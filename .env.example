#===============================================================================
# Chatvia environment settings
#
# Quick start (local):
#   cp .env.example .env
#   php artisan key:generate
#
# The values below work with the services in docker-compose.yml. Billing is
# off, files are stored on the local disk, documents are read and split on
# your server, and the public marketing site is off.
#
# Sections and keys marked "Required" must have a value. Secrets and API keys
# are empty here: fill in your own. Settings that are commented out
# ("# KEY=value") are optional and the app works without them. The value
# shown is the default or an example. To change one, remove the "#" and set
# a value.
#
# Before you go live, also set: APP_ENV=production, APP_DEBUG=false, an https
# APP_URL, SESSION_SECURE_COOKIE=true, TRUSTED_PROXIES (behind a proxy or CDN),
# REVERB_APP_SECRET, BUILTIN_MCP_SECRET, CSP_MODE, and STRIPE_WEBHOOK_SECRET
# when billing is on.
#
# Admins can also set the API keys and OAuth apps below (social login, Meta,
# AI providers, Firecrawl, chunk.fit, connectors, Stripe, Resend, Turnstile,
# IP2Location) in the admin panel, under Settings (/admin/settings). A value
# saved there is stored encrypted and is used instead of the value in this
# file. Remove it in the panel to use this file again.
#===============================================================================

#-------------------------------------------------------------------------------
# App (Required)
#-------------------------------------------------------------------------------
APP_NAME=Chatvia
APP_ENV=local
# Created by `php artisan key:generate`.
APP_KEY=
APP_DEBUG=true
# The address people use to open the app, without a trailing slash.
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Old app keys, comma-separated, so data encrypted with them can still be read
# after you rotate APP_KEY.
# APP_PREVIOUS_KEYS=

# APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# Workers for `php artisan serve --no-reload`. A chat answer streams for a
# while, so use more than one worker.
# PHP_CLI_SERVER_WORKERS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#-------------------------------------------------------------------------------
# Brand
#-------------------------------------------------------------------------------
# Your product name and links. Leave a URL empty to hide the link that uses it.
# BRAND_NAME="${APP_NAME}"
# BRAND_WEBSITE_URL=
# BRAND_DOCS_URL=
# BRAND_API_DOCS_URL=
# BRAND_ONBOARDING_VIDEO_URL=
# Social handle for the twitter:site meta tag, e.g. "@acme".
# BRAND_TWITTER_HANDLE=

# The "Powered by ..." line under hosted chats and widgets.
# BRAND_POWERED_BY_ENABLED=true
# BRAND_POWERED_BY_LABEL=Chatvia
# BRAND_POWERED_BY_URL=

# Public landing, pricing and legal pages. When false, "/" opens the app.
MARKETING_SITE_ENABLED=false

# The company that runs this install. Shown on the legal pages, the DPA and
# the footer. Leave a value empty to hide its line. Separate address lines
# with \n inside double quotes, e.g. "Main Street 1\n1000 Copenhagen".
# COMPANY_NAME=
# COMPANY_ADDRESS=
# COMPANY_EMAIL=
# COMPANY_VAT_ID=

#-------------------------------------------------------------------------------
# Database (Required)
#-------------------------------------------------------------------------------
# PostgreSQL 18 with the vchord, vchord_bm25, pg_tokenizer and vector
# extensions. These values match docker-compose.yml.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=chatvia
DB_USERNAME=chatvia
DB_PASSWORD=password

# TLS to the database: prefer (default), require or verify-full.
# Use require or verify-full in production.
# DB_SSLMODE=prefer

# Keep the default: search needs the extension schemas.
# DB_SEARCH_PATH="public, bm25_catalog, tokenizer_catalog"

# Pulse and Telescope store their data in the main database. To give them
# their own databases, create the databases, set these two to "pulse" and
# "telescope", and set DB_PULSE_DATABASE / DB_TELESCOPE_DATABASE.
PULSE_DB_CONNECTION=pgsql
DB_TELESCOPE_CONNECTION=pgsql
# DB_PULSE_DATABASE=pulse
# DB_TELESCOPE_DATABASE=telescope

# Analytics tables use the main database. Set ANALYTICS_DB_CONNECTION=analytics
# and DB_ANALYTICS_DATABASE to move them to their own database.
# ANALYTICS_DB_CONNECTION=
# DB_ANALYTICS_DATABASE=analytics

# The AI request log (Spectra) uses the main database. Set
# SPECTRA_DB_CONNECTION=spectra and DB_SPECTRA_DATABASE to move it.
# SPECTRA_DB_CONNECTION=
# DB_SPECTRA_DATABASE=spectra

# Host ports for `docker compose`. Change one when the port is already in use.
# FORWARD_DB_PORT=5432
# FORWARD_REDIS_PORT=6379
# FORWARD_MAILPIT_PORT=1025
# FORWARD_MAILPIT_DASHBOARD_PORT=8025

#-------------------------------------------------------------------------------
# Redis, cache, sessions and queues (Required)
#-------------------------------------------------------------------------------
# Redis is required: queues (Horizon), cache, rate limits and Pulse use it.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_URL=
# REDIS_PREFIX=chatvia_database_
# Redis database numbers for each use.
# REDIS_DB=0
# REDIS_CACHE_DB=1
# REDIS_CHAT_DB=2
# REDIS_PULSE_DB=3

CACHE_STORE=redis
# CACHE_PREFIX=chatvia_cache_

# Keep "database": deleting an account signs the user out by removing their
# rows from the sessions table.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

# Horizon runs the queues and needs "redis".
QUEUE_CONNECTION=redis

#-------------------------------------------------------------------------------
# Mail (Required)
#-------------------------------------------------------------------------------
# These values send all mail to Mailpit (web UI: http://localhost:8025).
# Use MAIL_MAILER=log to write mail to the log file instead.
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
# MAIL_SCHEME=
# MAIL_USERNAME=
# MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# API key for MAIL_MAILER=resend.
# RESEND_KEY=

#-------------------------------------------------------------------------------
# Broadcasting / Reverb (Required for live updates)
#-------------------------------------------------------------------------------
# Live updates (for example ingestion progress) go through Reverb. Start it
# with `php artisan reverb:start`.
BROADCAST_CONNECTION=reverb

# The app id and key are public (the browser sees the key). The secret is
# private. In production, set all three to long random values, for example
# from `openssl rand -hex 16`.
REVERB_APP_ID=chatvia-local
REVERB_APP_KEY=chatvia-local-key
# Required in production.
REVERB_APP_SECRET=

# Where the app and the browser reach Reverb.
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# Where the Reverb server listens.
# REVERB_SERVER_HOST=0.0.0.0
# REVERB_SERVER_PORT=8080
# Share connections across several Reverb servers through Redis.
# REVERB_SCALING_ENABLED=false

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

VITE_APP_NAME="${APP_NAME}"

# A second app served by the same Reverb process, for example another site on
# the same server. Only used when REVERB_EXTRA_APP_ID is set.
# REVERB_EXTRA_APP_ID=
# REVERB_EXTRA_APP_KEY=
# REVERB_EXTRA_APP_SECRET=
# REVERB_EXTRA_APP_HOST=
# REVERB_EXTRA_APP_PORT=443
# REVERB_EXTRA_APP_SCHEME=https
# Comma-separated, e.g. "https://example.com,https://www.example.com".
# REVERB_EXTRA_APP_ALLOWED_ORIGINS=

#-------------------------------------------------------------------------------
# Storage
#-------------------------------------------------------------------------------
# The app uses three disks: "private" (knowledge files, backups), "public"
# (chat attachments, chunk images) and "assets" (profile photos, widget logos).
# With nothing set below, all three use the local disk under storage/app.
# Run `php artisan storage:link` once so public files load at /storage.
FILESYSTEM_DISK=local

# Choose a driver per disk: local or s3 (private, public), local or bunnycdn
# (assets). When not set: s3 if SCALEWAY_BUCKET is set, bunnycdn if
# BUNNYCDN_STORAGE_ZONE is set, otherwise local.
# FILESYSTEM_PRIVATE_DRIVER=
# FILESYSTEM_PUBLIC_DRIVER=
# FILESYSTEM_ASSETS_DRIVER=

# S3-compatible object storage for the private and public disks. The names
# start with SCALEWAY_, but any S3-compatible service works.
# SCALEWAY_ACCESS_KEY_ID=
# SCALEWAY_SECRET_ACCESS_KEY=
# SCALEWAY_DEFAULT_REGION=
# SCALEWAY_ENDPOINT=
# SCALEWAY_USE_PATH_STYLE_ENDPOINT=false
# Private bucket and its URL.
# SCALEWAY_BUCKET=
# SCALEWAY_URL=
# Public bucket and its URL. Files here are readable by anyone with the link.
# SCALEWAY_BUCKET_PUBLIC=
# SCALEWAY_PUBLIC_URL=

# Bunny CDN storage for the assets disk.
# BUNNYCDN_STORAGE_ZONE=
# BUNNYCDN_PULL_ZONE=
# BUNNYCDN_API_KEY=
# Storage region code. "de" is the default (Falkenstein).
# BUNNYCDN_REGION=de

#-------------------------------------------------------------------------------
# Billing
#-------------------------------------------------------------------------------
# false: no Stripe needed. Every workspace gets every feature, there are no
# quotas, and the billing pages are off. Set true to sell plans with Stripe.
BILLING_ENABLED=false

# Open sign-up at /register. Default: on when billing is off, off when it is
# on. Set false after you have created your own account.
# REGISTRATION_ENABLED=true

# Days to keep conversations when billing is off. With billing on, each plan
# sets its own value.
# CONVERSATION_RETENTION_DAYS=366

# Stripe. Needed only when BILLING_ENABLED=true.
# STRIPE_KEY=
# STRIPE_SECRET=
# Required with billing on: in production the app does not start without it.
# STRIPE_WEBHOOK_SECRET=
# STRIPE_TRIAL_DAYS=7
# CASHIER_CURRENCY=eur
# CASHIER_CURRENCY_LOCALE=en
# BILLING_CURRENCY_SYMBOL=€
# Maximum automatic credit top-ups per workspace per 24 hours.
# AUTO_RECHARGE_MAX_PER_DAY=3

# Stripe price ids for each plan and add-on.
# STRIPE_STARTER_MONTHLY_PRICE_ID=
# STRIPE_STARTER_YEARLY_PRICE_ID=
# STRIPE_STANDARD_MONTHLY_PRICE_ID=
# STRIPE_STANDARD_YEARLY_PRICE_ID=
# STRIPE_PRO_MONTHLY_PRICE_ID=
# STRIPE_PRO_YEARLY_PRICE_ID=
# STRIPE_EXTRA_1000_MESSAGES_PRICE_ID=
# STRIPE_EXTRA_AGENT_PRICE_ID=
# STRIPE_CUSTOM_DOMAIN_PRICE_ID=
# STRIPE_REMOVE_BRANDING_PRICE_ID=
# STRIPE_MEMBERS_PRICE_ID=

#-------------------------------------------------------------------------------
# AI providers (Required for chat and search)
#-------------------------------------------------------------------------------
# You need a chat provider and an embedding provider. With the defaults, one
# SCALEWAYAI_API_KEY covers chat, embeddings, ranking and speech to text.
# See docs/guide/self-hosting/ai-providers.md.

# Chat provider: scaleway, mistral, openrouter or groq.
LLM_PROVIDER=scaleway
# Embedding provider: qwen, cohere, jina or mistral. It must return vectors
# with 1024 dimensions. If you change it later, train your sources again.
AI_EMBEDDING_PROVIDER=qwen

# Which service does each step. "auto" uses the hosted service when its API
# key is set, and the local tool (or "none") when it is not.
#   AI_DOCUMENT_PARSER  mistral | local      (PDF, office files, images)
#   AI_TEXT_SPLITTER    chunkfit | local     (split text into chunks)
#   AI_RERANKER         qwen | cohere | none (rank search results and tools)
#   AI_TRANSCRIBER      scaleway | none      (speech to text)
#   AI_DOCUMENT_LLM     mistral | none       (document summaries, chat with PDF)
AI_DOCUMENT_PARSER=auto
AI_TEXT_SPLITTER=auto
AI_RERANKER=auto
AI_TRANSCRIBER=auto
AI_DOCUMENT_LLM=auto

# Models that read whole PDF files (used with AI_DOCUMENT_LLM=mistral).
# AI_SUMMARY_MODEL=mistral-large-latest
# AI_ANALYSIS_MODEL=mistral-large-latest
# AI_DOCUMENT_CHAT_MODEL=mistral-medium-latest

# The model new agents start with (name from the model list in the database).
# AGENT_DEFAULT_MODEL=qwen3.6-35b-a3b
# How many recent messages are sent to the model on each turn.
# AGENT_HISTORY_MESSAGES=3
# Rewrite the question before search.
# QUERY_REWRITER_ENABLED=false
# Improve chunks with an extra AI step during ingestion.
# CHUNKER_ENHANCE=false

# Scaleway Generative APIs (chat, qwen embeddings and reranker, speech to
# text). Any server with the same OpenAI-style API works as the endpoint.
SCALEWAYAI_API_KEY=
# SCALEWAYAI_API_ENDPOINT=https://api.scaleway.ai/v1
# SCALEWAYAI_EMBEDDING_MODEL=qwen3-embedding-8b
# SCALEWAYAI_RERANK_MODEL=qwen3-embedding-8b
# SCALEWAYAI_TRANSCRIPTION_MODEL=whisper-large-v3

# Mistral (chat, document OCR, whole-PDF reading, embeddings).
# MISTRAL_API_KEY=
# MISTRAL_BASE_URL=https://api.mistral.ai/v1
# MISTRAL_OCR_MODEL=mistral-ocr-latest
# MISTRAL_EMBEDDING_MODEL=mistral-embed

# OpenRouter (chat).
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_COMPLETION_ENDPOINT=https://openrouter.ai/api/v1/chat/completions

# Groq (chat).
# GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_COMPLETION_ENDPOINT=https://api.groq.com/openai/v1/chat/completions

# Cohere (embeddings and reranker).
# COHERE_API_KEY=
# COHERE_API_ENDPOINT=https://api.cohere.com/v2
# COHERE_EMBEDDING_MODEL=embed-v4.0
# COHERE_EMBEDDING_DIMENSIONS=1024
# COHERE_RERANK_MODEL=rerank-v4.0-pro

# Jina (embeddings).
# JINA_API_KEY=
# JINA_API_ENDPOINT=https://api.jina.ai/v1
# JINA_EMBEDDING_MODEL=jina-embeddings-v3
# JINA_EMBEDDING_DIMENSIONS=1024

# chunk.fit (hosted text splitter, used with AI_TEXT_SPLITTER=chunkfit).
# CHUNK_FIT_API_KEY=
# CHUNK_FIT_BASE_URL=https://chunk.fit/api/v1
# CHUNK_FIT_TIMEOUT=120
# Chunk sizes, in characters.
# CHUNK_FIT_MAX_CHARACTERS=2000
# CHUNK_FIT_NEW_AFTER_N_CHARS=1500
# CHUNK_FIT_COMBINE_UNDER_N_CHARS=1000

# Firecrawl (website import). Website sources need it. The endpoint can point
# to a Firecrawl server that you run yourself.
# FIRECRAWL_API_KEY=
# FIRECRAWL_API_ENDPOINT=https://api.firecrawl.dev/v2
# Extra wait (ms) for pages that load content late, and the page timeout (ms).
# FIRECRAWL_WAIT_FOR=2000
# FIRECRAWL_SCRAPE_TIMEOUT=60000
# Requests per minute across all workers. 0 turns the limit off.
# FIRECRAWL_SCRAPE_RATE_PER_MINUTE=60

#-------------------------------------------------------------------------------
# Binaries
#-------------------------------------------------------------------------------
# The defaults are program names, found on the PATH of the process that runs
# them (usually the queue worker). Set a full path when a program is not on
# that PATH. You only need the programs for the file types you use.
# LIBREOFFICE_BIN_PATH=soffice
# PANDOC_BIN_PATH=pandoc
# PDFINFO_BIN_PATH=pdfinfo
# PDFTOTEXT_BIN_PATH=pdftotext
# FFMPEG_BIN_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# Headless Chrome for PDF export of chats. Empty = the Chrome that
# `npm install` downloads.
# CHROME_EXECUTABLE_PATH=
# NODE_BIN_PATH=
# NPM_BIN_PATH=
# NVM_INCLUDE_PATH=

#-------------------------------------------------------------------------------
# Security
#-------------------------------------------------------------------------------
# Signs the calls the app makes to its own built-in tools (charts, forms,
# weather, currency, web search). Required: built-in tools stop working while
# it is empty. Use a long random string, e.g. from `openssl rand -hex 32`.
BUILTIN_MCP_SECRET=

# Comma-separated proxy IPs or ranges in front of the app (load balancer,
# CDN). Required behind a proxy, or every visitor gets the proxy IP and rate
# limits stop working. "*" is allowed only when APP_ENV=local.
# TRUSTED_PROXIES=

# Send the session cookie only over HTTPS. Set true in production.
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax

# Content-Security-Policy: off | report-only | enforce. report-only never
# blocks anything. Switch to enforce once the reports are clean.
CSP_MODE=report-only
# Optional address that receives the CSP reports.
# CSP_REPORT_URI=

# Extra origins for passkey sign-in, comma-separated. APP_URL (and its www.
# form) is always allowed.
# PASSKEY_EXTRA_ORIGINS=

# Extra hosts where every agent's widget may load, on top of each agent's own
# allowed sites. The APP_URL host is always allowed. Comma-separated.
# WIDGET_ALWAYS_ALLOWED_ORIGINS=

# Origins allowed to call the API, chat and widget endpoints. Comma-separated.
# Keep "*" if agents' widgets run on other people's sites.
# CORS_ALLOWED_ORIGINS=*

# Lifetime of API tokens, in minutes (default: one year).
# SANCTUM_TOKEN_TTL_MINUTES=525600

# Limits for widget chat requests per agent, so public agents cannot be
# flooded.
# WIDGET_STREAM_PER_AGENT_PER_MINUTE=120
# WIDGET_STREAM_PER_AGENT_PER_HOUR=1500

# Cloudflare Turnstile bot check on the public contact form.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

#-------------------------------------------------------------------------------
# Channels
#-------------------------------------------------------------------------------
# Telegram, Slack and Microsoft Teams need no settings here: each agent gets
# its own credentials in the dashboard.
#
# Messenger, Instagram and WhatsApp use one Meta (Facebook) app for the whole
# install. Workspaces connect their pages and numbers through Facebook Login
# for Business.
# META_APP_ID=
# META_APP_SECRET=
# META_GRAPH_VERSION=v25.0
# Facebook Login for Business configuration ids. Instagram and WhatsApp use
# META_LOGIN_CONFIG_ID when their own id is empty.
# META_LOGIN_CONFIG_ID=
# META_INSTAGRAM_LOGIN_CONFIG_ID=
# META_WHATSAPP_LOGIN_CONFIG_ID=
# OAuth callback URLs. Add both to the Meta app's login settings.
# META_REDIRECT_URI="${APP_URL}/my/channels/messenger/oauth/callback"
# META_INSTAGRAM_REDIRECT_URI="${APP_URL}/my/channels/instagram/oauth/callback"
# Any random string. Use the same value in the Meta app's webhook settings.
# META_WEBHOOK_VERIFY_TOKEN=
# 6-digit PIN to register WhatsApp numbers. Do not use 000000.
# META_WHATSAPP_REGISTER_PIN=

#-------------------------------------------------------------------------------
# Connectors and built-in tools
#-------------------------------------------------------------------------------
# Some connectors need an OAuth app that you register with the service. Set
# its callback URL to ${APP_URL}/connectors/oauth/callback. Leave the keys
# empty if you do not offer that connector.
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# Google: Gmail, Google Calendar and Google Drive.
# GOOGLE_CONNECTOR_OAUTH_CLIENT_ID=
# GOOGLE_CONNECTOR_OAUTH_CLIENT_SECRET=
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# SLACK_OAUTH_CLIENT_ID=
# SLACK_OAUTH_CLIENT_SECRET=
# HUBSPOT_OAUTH_CLIENT_ID=
# HUBSPOT_OAUTH_CLIENT_SECRET=
# BOX_OAUTH_CLIENT_ID=
# BOX_OAUTH_CLIENT_SECRET=
# ASANA_OAUTH_CLIENT_ID=
# ASANA_OAUTH_CLIENT_SECRET=

# Built-in web search tool. Each workspace adds its own API key; these set
# the address and the models.
# PERPLEXITY_BASE_URL=https://api.perplexity.ai
# PERPLEXITY_AGENT_MODEL=perplexity/sonar
# PERPLEXITY_ASK_MODEL=sonar-pro
# PERPLEXITY_RESEARCH_MODEL=sonar-reasoning-pro

# Built-in weather and currency tools. Each workspace adds its own API key.
# OPEN_WEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
# EXCHANGE_RATE_API_BASE_URL=https://v6.exchangerate-api.com/v6

#-------------------------------------------------------------------------------
# Social login
#-------------------------------------------------------------------------------
# Sign in with Google, Microsoft, GitHub or Slack. Each needs an OAuth app with
# the callback URL shown.
# GOOGLE_AUTH_CLIENT_ID=
# GOOGLE_AUTH_CLIENT_SECRET=
# GOOGLE_AUTH_REDIRECT_URI="${APP_URL}/auth/google/callback"
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_REDIRECT_URI="${APP_URL}/auth/microsoft/callback"
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI="${APP_URL}/auth/github/callback"
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_REDIRECT_URI="${APP_URL}/auth/slack/callback"

#-------------------------------------------------------------------------------
# Observability
#-------------------------------------------------------------------------------
# Error reports to Flare. Nothing is sent while the key is empty.
# FLARE_KEY=

# Inbox for Horizon alerts (for example long queue waits). Empty = no alerts.
# HORIZON_NOTIFY_EMAIL=

# Pulse (server and queue metrics) at /pulse.
# PULSE_ENABLED=true
# Telescope (debug requests, jobs and queries) at /telescope.
# TELESCOPE_ENABLED=false
# Spectra keeps a log of AI requests (prompts and answers) at /spectra.
# SPECTRA_ENABLED=true

#-------------------------------------------------------------------------------
# Analytics
#-------------------------------------------------------------------------------
# Page-view analytics with Plausible, in production only. Nothing loads while
# the domain is empty. The script URL can point to your own Plausible server.
# PLAUSIBLE_DOMAIN=
# PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js

# IP location lookup for visitors (IP2Location.io).
# IP2LOCATION_API_KEY=
# IP2LOCATION_ENDPOINT=https://api.ip2location.io

#-------------------------------------------------------------------------------
# Seeding
#-------------------------------------------------------------------------------
# Login for the demo admin account that `php artisan db:seed` creates. The
# demo seeders never run in production.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=password

#-------------------------------------------------------------------------------
# Misc
#-------------------------------------------------------------------------------
# Inbox for the public contact form. Empty = the form is off.
# CONTACT_EMAIL=

# A personal welcome email to new trial sign-ups. Sent only when enabled and
# both name and email are set. Replies go to FOUNDER_EMAIL.
# FOUNDER_WELCOME_ENABLED=false
# FOUNDER_NAME=
# FOUNDER_EMAIL=

# User id that new support tickets are assigned to. Empty = the first admin
# user, or nobody when there is no admin.
# HELPDESK_DEFAULT_ASSIGNEE_ID=

# The chat widget script (the widget/ project). The default is the widget's
# dev server; in production, point it to your built embed.js.
# WIDGET_SCRIPT_URL=http://localhost:3000/dist/embed.js
# Agent id of the support chat shown on the marketing site.
# CHATVIA_WIDGET_ID=

# YouTube videos as knowledge sources. Not finished: added videos are saved
# but not ingested yet, so it is off by default.
# FEATURE_YOUTUBE_SOURCES=false

#-------------------------------------------------------------------------------
# Advanced tuning (optional)
#-------------------------------------------------------------------------------
# The defaults are fine for most installs.

# Agent tools.
# AGENT_TOOL_MAX_ITERATIONS=5
# AGENT_TOOL_APPROVAL_ENABLED=true
# AGENT_TOOL_APPROVAL_TTL_MINUTES=1440
# Only offer tools that score at least this much for the message (0 to 1).
# AGENT_TOOL_RELEVANCE_GATE=true
# AGENT_TOOL_RELEVANCE_THRESHOLD=0.55
# AGENT_TOOL_RELEVANCE_THRESHOLD_READ=0.45
# AGENT_TOOL_RELEVANCE_THRESHOLD_WRITE=0.55
# AGENT_TOOL_RERANK_CANDIDATES=12
# Experimental: an extra AI step that picks the connector for each turn.
# AGENT_TOOL_CONNECTOR_CLASSIFIER=false

# Knowledge search.
# VECTOR_SEARCH_MODE=default
# VECTOR_SEARCH_RERANK=true
# VECTOR_SEARCH_RELEVANCE_THRESHOLD=0.50
# VECTOR_SEARCH_MAX_CHUNKS=3
# VECTOR_SEARCH_RERANK_CANDIDATES=12
# Log a warning when a search takes longer than this (ms). 0 turns it off.
# VECTOR_SEARCH_SLOW_LOG_MS=2000
# VECTORCHORD_DEFAULT_PROBES=64
# VECTORCHORD_HIGH_ACCURACY_PROBES=128
# VECTORCHORD_HIGH_SPEED_PROBES=32
# VECTORCHORD_DEFAULT_EPSILON=1.9
# VECTORCHORD_HIGH_ACCURACY_EPSILON=2.5
# VECTORCHORD_HIGH_SPEED_EPSILON=1.4
# VECTORCHORD_BUILD_THREADS=4

# Chat stream replays: how long a request id is remembered (seconds), and in
# which cache store (empty = CACHE_STORE).
# SSE_DEDUPE_STORE=
# SSE_DEDUPE_TTL=600

# Conversation analytics and topic suggestions.
# ANALYTICS_ENABLED=true
# ANALYSIS_SCAN_AGE_HOURS=6
# TOPIC_SUGGESTION_MIN=3

# Tool-call audit log and tool rate limit (calls per window, in seconds).
# GOVERNANCE_AUDIT_ENABLED=true
# GOVERNANCE_RETENTION_DAYS=90
# GOVERNANCE_MAX_ARG_BYTES=4096
# GOVERNANCE_MAX_RESULT_BYTES=8192
# GOVERNANCE_TOOL_RATE_LIMIT=60
# GOVERNANCE_TOOL_RATE_WINDOW=60

# Security audit log.
# SECURITY_AUDIT_ENABLED=true
# SECURITY_AUDIT_RETENTION_DAYS=365
# SECURITY_AUDIT_RETENTION_FLOOR_DAYS=30
# SECURITY_AUDIT_MAX_METADATA_BYTES=8192

# Lowest conversation retention (days) a workspace may choose.
# CONVERSATION_RETENTION_FLOOR_DAYS=1

# Turn off a workspace's SIEM webhook after this many failures in a row.
# SIEM_WEBHOOK_MAX_FAILURES=15

# Agent evaluations.
# EVALS_MAX_CASES=100
# EVALS_MAX_OUTPUT_BYTES=8192

# Guardrails (PII, prompt injection, off-topic and toxicity checks).
# GUARDRAILS_ENABLED=true
# GUARDRAILS_RETENTION_DAYS=90
# GUARDRAILS_MAX_SNIPPET_BYTES=2048
