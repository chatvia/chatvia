#===============================================================================
# Chatvia environment settings
#
# Quick start (local):
#   cp .env.example .env
#   php artisan key:generate
#
# The values below work with the services in docker-compose.yml. Files are
# stored on the local disk, and documents are read on your server.
#
# Sections and keys marked "Required" must have a value. Secrets and API keys
# are empty here: fill in your own. Settings that are commented out
# ("# KEY=value") are optional and the app works without them. The value
# shown is the default or an example. To change one, remove the "#" and set
# a value.
#
# Before you go live, also set: APP_ENV=production, APP_DEBUG=false, an https
# APP_URL, SESSION_SECURE_COOKIE=true, TRUSTED_PROXIES (behind a proxy or CDN),
# REVERB_APP_SECRET and BUILTIN_MCP_SECRET.
#
# This file only holds what the app needs to start. Everything else is set in
# the admin panel, under Settings (/admin/settings): API keys and OAuth apps,
# the AI services and models, email, your brand, the default language,
# security headers, the chat widget, analytics, retention and limits. Secrets
# are stored encrypted in the database. You can also set them from the command
# line: `php artisan app:settings` lists them, `php artisan app:setting` sets
# one.
#
# Some lines below are marked "Optional preset". They fill in an admin-panel
# setting until a value is saved there, for example to use the services of
# docker-compose.yml. A value saved in the admin panel always wins. You do not
# need them: the admin panel is the normal place for these settings.
#===============================================================================

#-------------------------------------------------------------------------------
# App (Required)
#-------------------------------------------------------------------------------
# The app's name. The product name in the UI is always Chatvia.
APP_NAME=Chatvia
APP_ENV=local
# Created by `php artisan key:generate`.
APP_KEY=
APP_DEBUG=true
# The address people use to open the app, without a trailing slash. Each
# agent's hosted chat lives under it, at /chat/{agent}.
APP_URL=http://localhost:8000

# Chatvia's own site: where license keys (they hide the "Powered by Chatvia"
# credit) are sold and activated. Keep chatvia.ai; change it only to test
# against a local copy of the site.
CHATVIA_URI=https://chatvia.ai

# Laravel Sail: uncomment both lines to run the app, Horizon, the scheduler
# and Reverb in Docker too (see README.md). APP_PORT is the port of the app
# on your machine; Sail would use 80 without it.
# COMPOSE_PROFILES=sail
# APP_PORT=8000

# Optional preset: the default language. Normally set in the admin panel
# (Settings → Platform).
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Old app keys, comma-separated, so data encrypted with them can still be read
# after you rotate APP_KEY.
# APP_PREVIOUS_KEYS=

# APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# Workers for `php artisan serve --no-reload`. A chat answer streams for a
# while, so use more than one worker.
# PHP_CLI_SERVER_WORKERS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#-------------------------------------------------------------------------------
# Database (Required)
#-------------------------------------------------------------------------------
# PostgreSQL 18 with the vchord, vchord_bm25, pg_tokenizer and vector
# extensions. docker-compose.yml creates its database, user and password from
# these values.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=chatvia
DB_USERNAME=chatvia
DB_PASSWORD=password

# TLS to the database: prefer (default), require or verify-full.
# Use require or verify-full in production.
# DB_SSLMODE=prefer

# Keep the default: search needs the extension schemas.
# DB_SEARCH_PATH="public, bm25_catalog, tokenizer_catalog"

# Analytics tables use the main database. Set ANALYTICS_DB_CONNECTION=analytics
# and DB_ANALYTICS_DATABASE to move them to their own database.
# ANALYTICS_DB_CONNECTION=
# DB_ANALYTICS_DATABASE=analytics

# Pulse (/pulse) keeps its data in its own database on the same server, with
# the same user. `php artisan app:create-pulse-database` creates it (the
# Docker stacks do this for you); the user needs the CREATEDB right for that.
DB_PULSE_DATABASE=pulse

# Host ports for `docker compose`. Change one when the port is already in use.
# FORWARD_DB_PORT=5432
# FORWARD_REDIS_PORT=6379
# FORWARD_MAILPIT_PORT=1025
# FORWARD_MAILPIT_DASHBOARD_PORT=8025
# With Laravel Sail also: Reverb and the Vite dev server.
# FORWARD_REVERB_PORT=8080
# VITE_PORT=5173

#-------------------------------------------------------------------------------
# Redis, cache, sessions and queues (Required)
#-------------------------------------------------------------------------------
# Redis is required: queues (Horizon), cache and rate limits use it.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_URL=
# REDIS_PREFIX=chatvia_database_
# Redis database numbers for each use.
# REDIS_DB=0
# REDIS_CACHE_DB=1
# REDIS_CHAT_DB=2
# REDIS_SESSION_DB=3

CACHE_STORE=redis
# CACHE_PREFIX=chatvia_cache_

# Sessions live in Redis (their own database, REDIS_SESSION_DB).
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

# Horizon runs the queues and needs "redis".
QUEUE_CONNECTION=redis

#-------------------------------------------------------------------------------
# Mail (local development)
#-------------------------------------------------------------------------------
# Optional preset. How the app sends email is normally set in the admin panel
# (Settings → Email). These lines only preset it for local development: all
# mail goes to Mailpit (web UI: http://localhost:8025). The admin panel wins
# once you save there.
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

#-------------------------------------------------------------------------------
# Broadcasting / Reverb (Required for live updates)
#-------------------------------------------------------------------------------
# Live updates (for example ingestion progress) go through Reverb. Start it
# with `php artisan reverb:start`.
BROADCAST_CONNECTION=reverb

# The app id and key are public (the browser sees the key). The secret is
# private. In production, set all three to long random values, for example
# from `openssl rand -hex 16`.
REVERB_APP_ID=chatvia-local
REVERB_APP_KEY=chatvia-local-key
# Required in production.
REVERB_APP_SECRET=

# Where the app and the browser reach Reverb.
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# Where the Reverb server listens.
# REVERB_SERVER_HOST=0.0.0.0
# REVERB_SERVER_PORT=8080
# Share connections across several Reverb servers through Redis.
# REVERB_SCALING_ENABLED=false

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# A second app served by the same Reverb process, for example another site on
# the same server. Only used when REVERB_EXTRA_APP_ID is set.
# REVERB_EXTRA_APP_ID=
# REVERB_EXTRA_APP_KEY=
# REVERB_EXTRA_APP_SECRET=
# REVERB_EXTRA_APP_HOST=
# REVERB_EXTRA_APP_PORT=443
# REVERB_EXTRA_APP_SCHEME=https
# Comma-separated, e.g. "https://example.com,https://www.example.com".
# REVERB_EXTRA_APP_ALLOWED_ORIGINS=

#-------------------------------------------------------------------------------
# Storage
#-------------------------------------------------------------------------------
# The app uses two disks: "private" (knowledge files, chat attachments, chunk
# images, backups) and "assets" (profile photos, widget logos). With nothing
# set, both use the local disk under storage/app. Where the private disk keeps
# its files (this server or S3-compatible storage) is set in the admin panel
# (Settings → Storage). Run `php artisan storage:link` once so assets load at
# /storage.

# The assets disk is set only in this file: local or bunnycdn. When not set:
# bunnycdn if BUNNYCDN_STORAGE_ZONE is set, otherwise local.
# FILESYSTEM_ASSETS_DRIVER=
# Bunny CDN storage for the assets disk.
# BUNNYCDN_STORAGE_ZONE=
# BUNNYCDN_PULL_ZONE=
# BUNNYCDN_API_KEY=
# Storage region code. "de" is the default (Falkenstein).
# BUNNYCDN_REGION=de

#-------------------------------------------------------------------------------
# Workspaces
#-------------------------------------------------------------------------------
# Not set in this file. In the admin panel (Settings → Workspaces) you choose
# whether anyone can sign up at /register (on by default), the monthly
# message limit of new workspaces (0 = no limit, the default) and how many
# days conversations are kept (366 by default). A platform admin sets the
# limit of one workspace on its page under Workspaces.

#-------------------------------------------------------------------------------
# AI providers
#-------------------------------------------------------------------------------
# The AI services and their API keys are set in the admin panel: each key
# once in Settings → AI providers, and what runs on which provider in
# Settings → AI models. With the defaults, one Scaleway API key covers chat,
# embeddings and speech to text.
# See https://chatvia.ai/docs/guide/self-hosting/ai-providers.

# How the database stores embeddings. Set these BEFORE the first migration
# and never change them afterwards: the columns are created with them, and
# the app refuses to start when they no longer match the database
# (php artisan app:check-embedding-storage).
# - EMBEDDING_VECTOR_TYPE: halfvec (2 bytes per dimension, half the space,
#   almost the same search quality) or vector (4 bytes per dimension).
# - EMBEDDING_DIMENSIONS: 1024 works with every provider. Mistral only does
#   1024, Jina up to 1024, Cohere 256/512/1024/1536, OpenAI up to 1536
#   (3072 with text-embedding-3-large), Gemini 128-3072, Qwen3 up to 4096.
# EMBEDDING_VECTOR_TYPE=halfvec
# EMBEDDING_DIMENSIONS=1024

# Firecrawl (website import): extra wait (ms) for pages that load content
# late, and the page timeout (ms). Its address and API key are in the admin
# panel (Settings → Knowledge).
# FIRECRAWL_WAIT_FOR=2000
# FIRECRAWL_SCRAPE_TIMEOUT=60000

#-------------------------------------------------------------------------------
# Security
#-------------------------------------------------------------------------------
# Signs the calls the app makes to its own built-in tools (charts, forms,
# weather, currency, web search). Required: built-in tools stop working while
# it is empty. Use a long random string, e.g. from `openssl rand -hex 32`.
BUILTIN_MCP_SECRET=
# Where the app reaches its own built-in tools (/mcp/...) when APP_URL does
# not work from the server itself, for example inside a container. Empty uses
# APP_URL.
# BUILTIN_MCP_INTERNAL_URL=

# Comma-separated proxy IPs or ranges in front of the app (load balancer,
# CDN). Required behind a proxy, or every visitor gets the proxy IP and rate
# limits stop working. Empty trusts no proxy (with APP_ENV=local it trusts
# all). "*" is allowed only when APP_ENV=local.
# TRUSTED_PROXIES=

# Send the session cookie only over HTTPS. Set true in production.
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax

# The Content-Security-Policy, the bot check on the sign-in forms and the
# security audit log are set in the admin panel (Settings → Security). The
# widget's allowed sites and its request limits are in Settings → Platform.

# Extra origins for passkey sign-in, comma-separated. APP_URL (and its www.
# form) is always allowed.
# PASSKEY_EXTRA_ORIGINS=

# Origins allowed to call the API, chat and widget endpoints. Comma-separated.
# Keep "*" if agents' widgets run on other people's sites.
# CORS_ALLOWED_ORIGINS=*

# Lifetime of API tokens, in minutes (default: one year).
# SANCTUM_TOKEN_TTL_MINUTES=525600

#-------------------------------------------------------------------------------
# Channels
#-------------------------------------------------------------------------------
# Telegram, Slack and Microsoft Teams need no settings here: each agent gets
# its own credentials in the dashboard.
#
# Messenger, Instagram and WhatsApp each use a Meta (Facebook) app that you
# set up in the admin panel (Settings → Channels). Workspaces connect their
# pages, accounts and numbers through Facebook Login for Business.
# META_GRAPH_VERSION=v25.0

#-------------------------------------------------------------------------------
# Connectors and built-in tools
#-------------------------------------------------------------------------------
# Some connectors (GitHub, Gmail, Google Calendar, Google Drive, Slack,
# HubSpot, Box, Asana) need an OAuth app that you register with the service.
# Set its callback URL to ${APP_URL}/connectors/oauth/callback and enter it in
# the admin panel (Settings → Connectors). Leave it empty if you do not offer
# that connector.
#
# The built-in web search, weather and currency tools need no settings: each
# workspace adds its own API key. Their addresses and models are in the admin
# panel (Settings → Platform).

#-------------------------------------------------------------------------------
# Social login
#-------------------------------------------------------------------------------
# Sign in with Google, Microsoft, GitHub or Slack. Each needs an OAuth app,
# set up in the admin panel (Settings → Sign-in), which also shows the
# callback URL to register. A sign-in button only shows for a provider that
# is set up.

#-------------------------------------------------------------------------------
# Observability
#-------------------------------------------------------------------------------
# Error reports to Flare. Nothing is sent while the key is empty.
# FLARE_KEY=

# Pulse: the app's health at /pulse (slow requests, queries and jobs,
# exceptions, queues, cache, Reverb), for admins signed in to the admin panel.
# The Servers card needs `php artisan pulse:check` running all the time. Data
# older than 7 days is removed.
# PULSE_ENABLED=true

# Horizon alerts, the tracking code (page-view analytics) and visitor
# location (IP2Location) are set in the admin panel (Settings → Platform).

#-------------------------------------------------------------------------------
# Seeding
#-------------------------------------------------------------------------------
# Login for the demo admin account that `php artisan db:seed` creates. The
# demo seeders never run in production.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=password

#-------------------------------------------------------------------------------
# Misc
#-------------------------------------------------------------------------------
# YouTube videos as knowledge sources. Not finished: added videos are saved
# but not ingested yet, so it is off by default.
# FEATURE_YOUTUBE_SOURCES=false

#-------------------------------------------------------------------------------
# Advanced tuning (optional)
#-------------------------------------------------------------------------------
# The defaults are fine for most installs. Search, retention and rate limits
# are in the admin panel (Settings → Knowledge and Settings → Retention &
# limits).

# Agent tools.
# AGENT_TOOL_MAX_ITERATIONS=5
# AGENT_TOOL_APPROVAL_ENABLED=true
# AGENT_TOOL_APPROVAL_TTL_MINUTES=1440
# Only offer tools that score at least this much for the message (0 to 1).
# AGENT_TOOL_RELEVANCE_GATE=true
# AGENT_TOOL_RELEVANCE_THRESHOLD=0.55
# AGENT_TOOL_RELEVANCE_THRESHOLD_READ=0.45
# AGENT_TOOL_RELEVANCE_THRESHOLD_WRITE=0.55
# AGENT_TOOL_RERANK_CANDIDATES=12
# Experimental: an extra AI step that picks the connector for each turn.
# AGENT_TOOL_CONNECTOR_CLASSIFIER=false

# Knowledge search.
# VECTOR_SEARCH_RERANK_CANDIDATES=12
# VECTORCHORD_BUILD_THREADS=4

# Chat stream replays: the cache store that remembers request ids (empty =
# CACHE_STORE).
# SSE_DEDUPE_STORE=

# Conversation analytics and topic suggestions.
# ANALYTICS_ENABLED=true
# ANALYSIS_SCAN_AGE_HOURS=6
# TOPIC_SUGGESTION_MIN=3

# Tool-call audit log.
# GOVERNANCE_AUDIT_ENABLED=true

# Turn off a workspace's SIEM webhook after this many failures in a row.
# SIEM_WEBHOOK_MAX_FAILURES=15

# Agent evaluations.
# EVALS_MAX_CASES=100
