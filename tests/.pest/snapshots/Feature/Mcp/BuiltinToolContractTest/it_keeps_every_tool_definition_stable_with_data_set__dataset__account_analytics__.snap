    {
        "name": "get-handoff-stats-tool",
        "title": "Get Handoff Stats Tool",
        "description": "Human-handoff stats for a period: how many conversations were escalated from the\nAI to a human, the handoff rate (share of conversations), and how many handoffs\nare pending right now (awaiting a human, not period-bound). Answers \"how many\nchats went to a human?\", \"what's my escalation rate?\", \"any handoffs waiting?\".",
        "inputSchema": {
            "properties": {
                "period": {
                    "description": "Time window. Defaults to \"this_month\". Use \"last_month\" for the one before, or a rolling window like \"last_7_days\"/\"last_30_days\".",
                    "default": "this_month",
                    "enum": [
                        "this_month",
                        "today",
