<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Architecture">
            <directory>tests/Architecture</directory>
        </testsuite>
        <!-- On-demand eval harnesses (real embeddings; self-skip without an API
             key, so harmless in the default run). Target with the eval group. -->
        <testsuite name="Eval">
            <directory>tests/Eval</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src/App</directory>
            <directory>src/Domain</directory>
            <directory>src/Support</directory>
        </include>
    </source>
    <php>
        <!-- Applies inside every (parallel) worker process — the CLI default
             of 128M fatals partway through the suite. -->
        <ini name="memory_limit" value="2G"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="testing"/>
        <env name="DB_USERNAME" value="chatvia"/>
        <env name="DB_PASSWORD" value="password"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <!-- laravel-localization registers the landing routes once per boot under
             the locale this env names. Now that the default locale is explicit in
             the URL (hideDefaultLocaleInURL=false), force `en` so route('home') and
             friends resolve to /en in the harness, matching production. A test that
             needs un-prefixed (first-visit) registration reboots with this cleared. -->
        <env name="ROUTING_LOCALE" value="en"/>
    </php>
</phpunit>
