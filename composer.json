{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "chatvia/chatvia",
    "type": "project",
    "description": "Chatvia: an AI chat-agent platform. Agents answer from your knowledge base (RAG), call tools over MCP, and talk to visitors on the web widget, hosted chat and messaging channels.",
    "keywords": [
        "laravel",
        "inertia",
        "vue",
        "ai",
        "chatbot",
        "rag",
        "mcp",
        "llm"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-intl": "*",
        "ext-libxml": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "aws/aws-sdk-php": "^3.351",
        "cesargb/laravel-magiclink": "^2.24",
        "dedoc/scramble": "^0.13.23",
        "filament/filament": "^5.0",
        "firebase/php-jwt": "^v7.0.5",
        "graham-campbell/markdown": "^16.0",
        "inertiajs/inertia-laravel": "^3.0",
        "intervention/image": "^4.3",
        "intervention/image-laravel": "^4.1",
        "irazasyed/telegram-bot-sdk": "^3.16",
        "laravel/cashier": "^16.0",
        "laravel/fortify": "^1.37",
        "laravel/framework": "^13.0",
        "laravel/horizon": "^5.33",
        "laravel/mcp": "^1.0",
        "laravel/pennant": "^1.23",
        "laravel/pulse": "^1.4",
        "laravel/reverb": "^1.0",
        "laravel/sanctum": "^4.0",
        "laravel/slack-notification-channel": "^3.6",
        "laravel/socialite": "^5.23",
        "laravel/telescope": "^5.10",
        "laravel/tinker": "^3.0",
        "laravel/wayfinder": "^0.1.20",
        "league/commonmark": "^2.7",
        "league/flysystem-aws-s3-v3": "^3.0",
        "mcamara/laravel-localization": "^2.4",
        "pgvector/pgvector": "^0.2.2",
        "platformcommunity/flysystem-bunnycdn": "^3.3",
        "resend/resend-php": "^1.16",
        "ryangjchandler/laravel-cloudflare-turnstile": "^3.0",
        "socialiteproviders/microsoft": "^4.7",
        "spatie/browsershot": "^5.4",
        "spatie/laravel-data": "^4.15",
        "spatie/laravel-flare": "^3.0",
        "spatie/laravel-markdown": "^2.7",
        "spatie/laravel-pdf": "^2.0",
        "spatie/laravel-permission": "^8.3",
        "spatie/laravel-typescript-transformer": "^3.3",
        "spatie/typescript-transformer": "^3.3",
        "spectra-php/laravel-spectra": "^1.2.0",
        "tightenco/ziggy": "^2.5",
        "yethee/tiktoken": "^1.1"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.7",
        "driftingly/rector-laravel": "^2.4",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/boost": "^2.0",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.18",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.3",
        "spatie/laravel-horizon-watcher": "^1.1",
        "spatie/laravel-ray": "^1.43"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/App/",
            "Domain\\": "src/Domain/",
            "Support\\": "src/Support/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
        ],
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "@putenv APP_ENV=testing",
            "@php artisan config:clear --ansi",
            "@php -d memory_limit=2G artisan test"
        ],
        "format": "vendor/bin/pint",
        "format:check": "vendor/bin/pint --test",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=2G",
        "refactor": "vendor/bin/rector process",
        "refactor:check": "vendor/bin/rector process --dry-run",
        "ci": [
            "Composer\\Config::disableProcessTimeout",
            "npm run format",
            "npm run lint",
            "@format",
            "@refactor",
            "@ci:check"
        ],
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "@composer validate --strict",
            "@composer audit",
            "npm audit --omit=dev",
            "@format:check",
            "@refactor:check",
            "@analyse",
            "npm run format:check",
            "npm run lint:check",
            "npm run typecheck",
            "npm run i18n:check",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "dev": "Run the app server, queue worker, log tail and Vite together.",
        "test": "Run the Pest test suite against the testing database.",
        "format": "Fix PHP code style with Pint.",
        "format:check": "Check PHP code style with Pint without changing files.",
        "analyse": "Run PHPStan (Larastan) static analysis.",
        "refactor": "Apply Rector refactorings.",
        "refactor:check": "Show pending Rector refactorings without changing files.",
        "ci": "Auto-fix formatting, lint and Rector findings, then run ci:check.",
        "ci:check": "Run every CI gate without changing files: composer validate + audit, npm audit (production deps), Pint, Rector, PHPStan, Prettier, ESLint, vue-tsc, i18n check and the test suite."
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "audit": {
            "abandoned": "report"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
