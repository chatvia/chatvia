    intro 'Commands' "$(pretty_path "$DIR")"
    help_section 'Run Chatvia'
    help_row 'start' 'Start Chatvia'
    help_row 'stop' 'Stop Chatvia (your data is kept)'
    help_row 'restart [SERVICE]' 'Restart Chatvia, or one service'
    help_row 'status' 'Show the services, the version and the address'
    help_row 'logs [SERVICE]' 'Follow the logs (Ctrl-C to stop)'
    help_row 'upgrade' 'Back up, then upgrade to the newest version'
    help_row 'rollback [FILE]' 'Go back to the version before the last upgrade'
    help_section 'Backups'
    help_row 'backup' 'Back up the database, the app key and Redis'
    help_row 'backups' 'List the backups'
    help_row 'restore [FILE]' 'Replace all data with a backup'
    help_section 'Accounts'
    help_row 'password [EMAIL]' 'Set a new password for an account'
    help_row 'admin [EMAIL]' 'Create another admin account'
    help_section 'PostgreSQL'
    help_row 'postgres tune' 'Size the settings to the memory and processors'
    help_row 'postgres edit' 'Edit the settings, then apply them'
    help_row 'postgres apply' 'Apply postgres/postgresql.conf after a change'
    help_row 'postgres export' 'Start over from the default settings'
    help_row 'psql' 'Open a PostgreSQL prompt'
    help_section 'More'
    help_row 'artisan ARGS' 'Run an Artisan command in the app'
    help_row 'shell' 'Open a shell in the app container'
    help_row 'sync-tools' 'Add the built-in tools to the tool catalog'
    help_row 'uninstall' 'Delete Chatvia and all its data'
    block text
    info "$(dim './manage help COMMAND shows the options of a command.')"
