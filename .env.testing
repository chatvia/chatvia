GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Document Processing
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_API_KEY=
LLAMA_PARSE_API_KEY=

# Web Scraping
SPIDER_API_KEY=

# Ingestion Endpoint
INGESTION_ENDPOINT_URL=http://localhost:8000

# Widget
