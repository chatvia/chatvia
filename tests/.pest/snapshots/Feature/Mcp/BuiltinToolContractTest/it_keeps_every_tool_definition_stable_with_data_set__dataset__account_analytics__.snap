    {
        "name": "get-ai-usage-tool",
        "title": "Get Ai Usage Tool",
        "description": "What the AI relied on for a period: the most-called custom functions (webhook\ntools), the most-used MCP connector tools, and the most-retrieved knowledge\nsources. Answers \"which tools does my agent use most?\", \"what knowledge gets\npulled the most?\".",
        "inputSchema": {
            "properties": {
                "period": {
                    "description": "Time window. Defaults to \"this_month\". Use \"last_month\" for the one before, or a rolling window like \"last_7_days\"/\"last_30_days\".",
                    "default": "this_month",
                    "enum": [
                        "this_month",
                        "today",
                        "last_7_days",
                        "last_30_days",
                        "last_month",
                        "all_time"
                    ],
                    "type": "string"
