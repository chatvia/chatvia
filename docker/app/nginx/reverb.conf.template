# WebSocket connections for live updates (Laravel Echo, Pusher protocol) go
# to the Reverb container. Filled in by /etc/entrypoint.d/60-chatvia.sh.
# Only /app/ is forwarded: Reverb's HTTP API (/apps/) stays inside the Docker
# network, where the app reaches it directly.
location ^~ /app/ {
    resolver __RESOLVER__ valid=10s;
    set $reverb_upstream http://__REVERB_UPSTREAM__;

    proxy_pass $reverb_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "Upgrade";
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
}
