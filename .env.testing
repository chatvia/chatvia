APP_NAME=ChatVia
APP_ENV=testing
APP_KEY=base64:GuiDqV+2XrLtEiBwN85NBL32lUHl56XFPkFY3eRC+QY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Testing Database - Use in-memory SQLite for fast tests
DB_CONNECTION=pgsql
DB_DATABASE=testing
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=chatvia
DB_PASSWORD=password

# Use sync queue for immediate execution during tests
QUEUE_CONNECTION=sync

# Use array driver for cache during tests
CACHE_STORE=array
CACHE_PREFIX=

# Use array driver for session during tests
SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Broadcast
BROADCAST_CONNECTION=log

# Filesystem
FILESYSTEM_DISK=local

# Mail - Use log driver for testing
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS (for testing with mocked services)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Scaleway (for testing with mocked services)
SCALEWAY_ACCESS_KEY_ID=
SCALEWAY_SECRET_ACCESS_KEY=
SCALEWAY_DEFAULT_REGION=fr-par
SCALEWAY_BUCKET=
SCALEWAY_ENDPOINT=
SCALEWAY_URL=
SCALEWAY_USE_PATH_STYLE_ENDPOINT=false

# Redis - Not used during array cache testing
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=
REDIS_PERSISTENT=1

# Reverb - Use array for testing
REVERB_APP_ID=test-app-id
REVERB_APP_KEY=test-app-key
REVERB_APP_SECRET=test-app-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_APP_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Telescope - Disabled during tests for performance
TELESCOPE_ENABLED=false

# Nightwatch
NIGHTWATCH_TOKEN=
NIGHTWATCH_REQUEST_SAMPLE_RATE=1

# Octane
OCTANE_HTTPS=false

# Sentry - Disabled during tests
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_SEND_DEFAULT_PII=false

# Turnstile - Use testing keys
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Social Login - Use test credentials
GOOGLE_CLIENT_ID=test-google-client-id
GOOGLE_CLIENT_SECRET=test-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost/auth/google/callback

MICROSOFT_CLIENT_ID=test-microsoft-client-id
MICROSOFT_CLIENT_SECRET=test-microsoft-client-secret
MICROSOFT_REDIRECT_URI=http://localhost/auth/microsoft/callback

# Stripe - Use test keys (replace with actual test keys if needed)
STRIPE_KEY=pk_test_
STRIPE_SECRET=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_test_

# Stripe Price IDs (use test price IDs)
STRIPE_STARTER_MONTHLY_PRICE_ID=price_test_starter_monthly
STRIPE_STARTER_YEARLY_PRICE_ID=price_test_starter_yearly
STRIPE_STANDARD_MONTHLY_PRICE_ID=price_test_standard_monthly
