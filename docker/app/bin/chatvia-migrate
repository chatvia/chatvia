#!/bin/sh
# One-shot: prepares the database. Runs on every start of the stack, before
# the web server and the workers, so an upgrade migrates before the new code
# serves requests. Every step is safe to repeat.
#
#   1. wait for PostgreSQL
#   2. chatvia:deploy:migrate, the same steps a Deployer deploy runs: the
#      analytics, Pulse and Spectra databases, the migrations (the first one
#      installs the search extensions), the embedding checks and the
#      built-in tools
#   3. create the first admin from ADMIN_EMAIL / ADMIN_PASSWORD, while the
#      install has no admin yet
set -eu

cd "${APP_BASE_DIR:-/var/www/chatvia}"

# Connects through Laravel, so the settings come from the same place as the
# app's: environment variables, then the image's .env.
database_is_ready() {
    # shellcheck disable=SC2016 # PHP code: the $ signs are PHP's
    php -r '
        require "vendor/autoload.php";
        $app = require "bootstrap/app.php";
        $app->make(Illuminate\Contracts\Console\Kernel::class)->bootstrap();
        Illuminate\Support\Facades\DB::connection()->getPdo();
    ' > /dev/null 2>&1
}

echo "Waiting for the database..."
attempt=0
until database_is_ready; do
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 60 ]; then
        echo "The database did not answer within 2 minutes." >&2
        exit 1
    fi
    sleep 2
done

# Stops the start when a step fails, for example when the embedding settings
# were changed after install.
php artisan chatvia:deploy:migrate --no-interaction

admin_email="${ADMIN_EMAIL:-admin@example.com}"
admin_password="${ADMIN_PASSWORD:-}"
generated_password=false
if [ -z "$admin_password" ]; then
    admin_password=$(php -r 'echo bin2hex(random_bytes(12));')
    generated_password=true
fi

output=$(php artisan chatvia:admin:create-user "$admin_email" "${ADMIN_NAME:-Admin}" "$admin_password" --if-no-admin --if-missing --no-interaction)
echo "$output"

if [ "$generated_password" = true ] && echo "$output" | grep -q 'created successfully'; then
    cat <<EOF

================================================================
  First admin account created. This password is shown only once.

  Email:    $admin_email
  Password: $admin_password

  Sign in, then change the password under Account settings.
================================================================

EOF
fi
