}

help_section() {
    section "$1"
}

help_row() {
    info "$(printf '%-20s' "$1")$(dim "$2")"
}

command_help() {
    local name=$1
    intro "./manage $name" "$(pretty_path "$DIR")"
    case $name in
        start) info 'Starts Chatvia. The database is updated first, then the app.' ;;
        stop) info 'Stops every container. Your data stays in its Docker volumes.' ;;
        restart)
            info 'Without a service: stops and starts Chatvia, so changes to .env apply.'
            info "With services: recreates only them. Services: $SERVICES"
            ;;
        status) info 'Shows whether the app answers, its version, and the health of each service.' ;;
        logs)
            info 'Follows the logs of all services, or of the ones you name.'
            info "$(dim 'Other docker compose logs options work too, like --since 1h.')"
            ;;
        upgrade)
            info 'Upgrades to the newest version, or to the one you name. It shows the change'
            info 'and the release notes, backs up, then runs the installer. The new version'
            info 'is downloaded before anything stops, and the database is updated before it'
            info 'serves requests. When the new version does not start, it offers to go back.'
            help_option '--version V' 'A version like 1.4.2, or 1.4 for the newest 1.4.x'
            help_option '--no-backup' 'Skip the backup (then it cannot go back on its own)'
            help_option '--no-pull' 'Use an image built on this machine (with --version TAG)'
            help_option '--yes' 'No questions; goes back on its own when the upgrade fails'
            ;;
        rollback)
            info 'Goes back to the version before an upgrade: it gets that version ready, then'
            info 'restores the backup made before the upgrade (the newest one, or FILE).'
            info 'Everything since that backup is replaced, so it backs up the current data first.'
            help_option '--no-backup' 'Skip the backup of the current data'
            help_option '--yes' 'No questions'
            ;;
        backup)
            info "Saves a backup in $(pretty_path "$(backup_dir)"): the database, the search"
            info 'tokenizers and settings that pg_dump misses, the app key, and Redis'
            info '(who is signed in, the chat memory).'
            help_option '--files' 'Also the uploaded files (when they are stored here, not in S3)'
            help_option '--no-secrets' 'Leave out the app key (keep it somewhere else then)'
            help_option '--no-redis' 'Leave out Redis (sign-ins and chat memory)'
            help_option '--keep N' 'Then delete all but the newest N backups'
            info ''
            info "$(dim 'Every night at 3, keeping a week:')"
            info "$(dim "0 3 * * * $DIR/manage backup --keep 7")"
            ;;
        backups) info 'Lists the backups, oldest first.' ;;
        restore)
            info 'Replaces all data with a backup. Without FILE you choose one from the list.'
            info 'It backs up the current data first, restores next to it, and only then'
            info 'switches over: a failed restore leaves your data as it was. Redis comes back'
            info 'too (sign-ins, chat memory); its queues and cache start empty.'
            info "$(dim 'FILE can also be a plain pg_dump file (custom format).')"
            help_option '--no-backup' 'Skip the backup of the current data'
            help_option '--yes' 'No questions (FILE is needed then)'
            ;;
        password)
            info 'Sets a new password for an account. The e-mail defaults to the first admin.'
            help_option '--disable-2fa' 'Also turn off two-factor sign-in'
            help_option '--yes' 'No questions: makes a random password'
            ;;
        admin)
            info 'Creates another admin account, with its own workspace.'
            help_option '--name NAME' 'The name (default: Admin)'
            help_option '--yes' 'No questions: makes a random password'
            ;;
        postgres)
            info "PostgreSQL reads its settings from $(pretty_path "$(pg_conf)")."
            help_option 'tune' 'Size the settings to the memory and processors it gets'
            help_option 'edit' 'Open the file in your editor ($EDITOR), then apply it'
            help_option 'apply' 'Check the file, reload it, and restart when needed'
            help_option 'export' 'Write the file again from the default settings'
            info ''
            info "The tune computes the usual sizes for a web app on SSD storage, like"
            info "pgtune: shared_buffers, work_mem, the WAL sizes, the parallel workers."
            info "It shows every change and asks first. Its lines are marked"
            info "$(dim '# set by Chatvia tune'); a new run replaces them and never your own edits."
            ;;
        psql) info 'Opens psql on the Chatvia database. Arguments go to psql, like -c "SELECT 1".' ;;
        artisan) info 'Runs php artisan in the app container, like ./manage artisan about.' ;;
        shell) info 'Opens a shell in the app container.' ;;
        sync-tools) info 'Adds the built-in tools (charts, forms, weather, ...) to the tool catalog.' ;;
        uninstall)
            info 'Deletes the containers, all data and the settings files. Backups are kept.'
            info 'It offers a last backup first, and asks you to type delete.'
            ;;
        *) die "There is no command called $name." 'See ./manage help' ;;
    esac
    outro "$(dim "Guide: $CHATVIA_DOCS")"
}

help_option() {
    info "  $(printf '%-20s' "$1")$(dim "$2")"
}

#------------------------------------------------------------------------------
# Main
#------------------------------------------------------------------------------

cleanup() {
    keys_off
    if [ -n "${RESTORE_DB:-}" ]; then drop_restore_database "$RESTORE_DB"; fi
    if [ -n "${TMP_BACKUP:-}" ]; then rm -rf "$TMP_BACKUP"; fi
    if [ -n "${TMP_PARTIAL:-}" ]; then rm -f "$TMP_PARTIAL"; fi
    if [ -n "${WORK_DIR:-}" ]; then rm -rf "$WORK_DIR"; fi
    unlock
}

interrupted() {
    keys_off
    printf '\n  %s  %s\n\n' "$END" 'Stopped.'
    exit 130
}

main() {
    YES=0 USE_SUDO=0 LOCKED=0 TTY_STATE='' STARTED_POSTGRES=0 STARTED_REDIS=0 TMP_BACKUP='' TMP_PARTIAL='' RESTORE_DB=''
    BACKUP_FILE='' BACKUP_HOLDS='' PASSWORD_INPUT='' RESTORED_STORAGE='' OUTPUT=''
    setup_output

    case "$(uname -s)" in
        Darwin) OS=macos ;;
        *) OS=linux ;;
    esac

    DIR=${CHATVIA_DIR:-$(script_dir)}
    if [ ! -f "$DIR/compose.yaml" ]; then
        die "There is no Chatvia install in $(pretty_path "$DIR") (no compose.yaml)." \
            'Run this from the install folder, or set CHATVIA_DIR.'
    fi

    COMMAND=${1:-help}
    if [ $# -gt 0 ]; then shift; fi
    # --yes anywhere before a pass-through command's own arguments.
    case $COMMAND in
        --yes | -y)
            YES=1
            COMMAND=${1:-help}
            if [ $# -gt 0 ]; then shift; fi
            ;;
    esac
    case $COMMAND in
        artisan | psql | logs) ;;
        *)
            local arg
            for arg in "$@"; do
                case $arg in
                    --yes | -y) YES=1 ;;
                    -h | --help) COMMAND="help $COMMAND" ;;
                esac
            done
            ;;
    esac

    INTERACTIVE=1
    if [ "$YES" = 1 ] || ! { : </dev/tty; } 2>/dev/null; then INTERACTIVE=0; fi
    if [ "$INTERACTIVE" = 1 ]; then
        TTY_STATE=$(stty -g 2>/dev/null </dev/tty) || TTY_STATE=''
    fi

    trap cleanup EXIT
    trap interrupted INT TERM
    WORK_DIR=$(mktemp -d 2>/dev/null || mktemp -d -t chatvia-manage)
    LOG="$DIR/manage.log"
    if [ ! -f "$LOG" ]; then (umask 077 && : >"$LOG"); fi
    # Keeps the log short: only the end of a large one.
    if [ "$(file_size "$LOG")" -gt 1048576 ]; then
        tail -n 2000 "$LOG" >"$WORK_DIR/log" && cat "$WORK_DIR/log" >"$LOG"
    fi
    printf '\n==== %s ./manage %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$COMMAND" >>"$LOG"

    case $COMMAND in
        help | -h | --help)
            if [ $# -gt 0 ]; then command_help "$1"; else usage; fi
            ;;
        help\ *) command_help "${COMMAND#help }" ;;
        start) cmd_start "$@" ;;
        stop) cmd_stop "$@" ;;
        restart) cmd_restart "$@" ;;
        status) cmd_status "$@" ;;
        logs) cmd_logs "$@" ;;
        upgrade) cmd_upgrade "$@" ;;
        rollback) cmd_rollback "$@" ;;
        backup) cmd_backup "$@" ;;
        backups) cmd_backups "$@" ;;
        restore) cmd_restore "$@" ;;
        password) cmd_password "$@" ;;
        admin) cmd_admin "$@" ;;
        postgres) cmd_postgres "$@" ;;
        psql) cmd_psql "$@" ;;
        artisan) cmd_artisan "$@" ;;
        shell) cmd_shell "$@" ;;
        sync-tools) cmd_sync_tools "$@" ;;
        uninstall) cmd_uninstall "$@" ;;
        *) die "There is no command called $COMMAND." 'See ./manage help' ;;
    esac
}

main "$@"
