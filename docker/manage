cmd_backup() {
    local with_files=0 with_secrets=1 with_redis=1 keep=''
    while [ $# -gt 0 ]; do
        case $1 in
            --files) with_files=1 ;;
            --no-secrets) with_secrets=0 ;;
            --no-redis) with_redis=0 ;;
            --keep)
                keep=${2:-}
                [[ $keep =~ ^[1-9][0-9]*$ ]] || die '--keep needs a number of backups, like --keep 7.'
                shift
                ;;
            --yes | -y) ;;
            *) die "Unknown option: $1" 'See ./manage help backup' ;;
        esac
        shift
    done

    intro 'Backup' "$(pretty_path "$DIR")"
    check_docker
    lock
    do_backup "$with_files" "$with_secrets" "$with_redis"
    # Left as it was found.
    if [ "$STARTED_POSTGRES" = 1 ]; then compose stop postgres >>"$LOG" 2>&1 || true; fi
    if [ "$STARTED_REDIS" = 1 ]; then compose stop redis >>"$LOG" 2>&1 || true; fi
    if [ -n "$keep" ]; then prune_backups "$keep"; fi

    local file size holds
    kv_to file 'File' "$(pretty_path "$BACKUP_FILE")"
    kv_to size 'Size' "$(human_size "$(file_size "$BACKUP_FILE")")"
    kv_to holds 'Holds' "$(describe_holds "$BACKUP_HOLDS")"
    note "$(bold 'Backup saved')" "$file" "$size" "$holds"
    if [ "$with_secrets" = 1 ]; then
        info "$(dim 'It holds your app key, so keep it as private as your database.')"
    fi
    info "$(dim 'Copy it to another machine: a backup on the same disk does not survive the disk.')"
    outro "Restore it with $(accent "./manage restore ${BACKUP_FILE##*/}")"
}

cmd_backups() {
    no_options "$@"
    intro 'Backups' "$(pretty_path "$(backup_dir)")"
    local file total=0 count=0 size
    while IFS= read -r file; do
        size=$(file_size "$file")
        total=$((total + size))
        count=$((count + 1))
        info "${file##*/}  $(dim "$(human_size "$size")")"
    done < <(list_backups)
    if [ "$count" = 0 ]; then
        outro "No backups yet. Make one: $(accent './manage backup')"
        return
    fi
    outro "$count backup(s), $(human_size "$total"). Restore one: $(accent './manage restore NAME')"
}

# resolve_backup NAME: a path, or a name in the backups folder.
resolve_backup() {
    if [ -f "$1" ]; then
        printf '%s' "$1"
    elif [ -f "$(backup_dir)/$1" ]; then
        printf '%s' "$(backup_dir)/$1"
    else
        return 1
    fi
}

cmd_restore() {
    local file='' name='' safety=1 kind members magic holds created version
    while [ $# -gt 0 ]; do
        case $1 in
            --no-backup) safety=0 ;;
            --yes | -y) YES=1 INTERACTIVE=0 ;;
            -*) die "Unknown option: $1" 'See ./manage help restore' ;;
            *) file=$1 name=$1 ;;
        esac
        shift
    done

    intro 'Restore' "$(pretty_path "$DIR")"
    need_terminal 'A restore replaces all data, so it asks first.'
    check_docker
    lock

    if [ -z "$file" ]; then
        local backups=() options=() entry
        while IFS= read -r entry; do backups=("$entry" ${backups[@]+"${backups[@]}"}); done < <(list_backups)
        if [ "${#backups[@]}" = 0 ]; then
            die "There are no backups in $(pretty_path "$(backup_dir)")." 'Name a backup file: ./manage restore FILE'
        fi
        if [ "$INTERACTIVE" = 0 ]; then
            die 'Name the backup to restore: ./manage restore FILE --yes'
        fi
        for entry in "${backups[@]:0:9}"; do
            options+=("${entry##*/}  — $(human_size "$(file_size "$entry")")")
        done
        choose 'Which backup?' "${options[@]}"
        file=${backups[CHOICE]}
    else
        file=$(resolve_backup "$file") || die "There is no backup called $name." 'List them: ./manage backups'
    fi

    # A backup from ./manage, or a plain pg_dump file (custom format), like
    # the ones the app makes on its own schedule.
    magic=$(head -c 5 "$file" 2>/dev/null) || magic=''
    members=$(tar -tf "$file" 2>/dev/null) || members=''
    if [ "$magic" = PGDMP ]; then
        kind=dump holds='database' created='' version=''
    elif [[ $'\n'$members$'\n' == *$'\n'backup.env$'\n'* && $'\n'$members$'\n' == *$'\n'database.dump$'\n'* ]]; then
        kind=full
        holds=$(backup_value "$file" HOLDS)
        created=$(backup_value "$file" CREATED)
        created=${created%Z}
        version=$(backup_value "$file" VERSION)
    else
        die "$(pretty_path "$file") is not a Chatvia backup." 'Use a file from ./manage backup, or a pg_dump file (custom format).'
    fi

    local row_file row_made row_holds row_now
    kv_to row_file 'Backup' "${file##*/}  $(dim "$(human_size "$(file_size "$file")")")"
    created=${created/T/ }
    kv_to row_made 'Made' "${created:-unknown}${created:+ UTC}${version:+  $(dim "(version $version)")}"
    kv_to row_holds 'Holds' "$(describe_holds "$holds")"
    kv_to row_now 'Current data' "${C_YELLOW}replaced$C_RESET$(dim ', after a backup of it')"
    if [ "$safety" = 0 ]; then kv_to row_now 'Current data' "${C_YELLOW}replaced, with no backup of it$C_RESET"; fi
    note 'Restore this backup?' "$row_file" "$row_made" "$row_holds" "$row_now"
    case " $holds " in
        *' secrets '*) ;;
        *) info "$(dim 'The backup has no app key: the current one is kept. Values encrypted with another key cannot be read.')" ;;
    esac

    if [ "$INTERACTIVE" = 1 ] && ! confirm 'Replace all current data with this backup?' n; then
        outro 'Nothing was changed.'
        return
    fi

    if [ "$safety" = 1 ]; then
        section 'Backup of the current data'
        local files_too=0
        case " $holds " in *' files '*) files_too=1 ;; esac
        do_backup "$files_too" 1 1 before-restore
        ok "Saved $(dim "$(pretty_path "$BACKUP_FILE")")"
    fi

    section 'Restore'
    restore_backup "$file" "$kind" "$holds"

    ok "$(bold 'Restored.')"
    outro "Chatvia is running at $(accent "$(app_url)")"
}

# restore_backup FILE KIND HOLDS: restores the database next to the current
# one, switches over, puts back what else the backup holds, and starts
# Chatvia (the version compose.yaml and .env name now).
restore_backup() {
    local file=$1 kind=$2 holds=$3
    ensure_postgres
    run_step 'Starting Redis' compose up -d --wait redis || die 'Redis did not start.'

    local db restore_db extras="$WORK_DIR/database-extras.sql"
    db=$(sql_value 'SELECT current_database()' 2>>"$LOG") ||
        die 'Could not reach the database.' 'See why: ./manage logs postgres'
    restore_db="${db}_restore"
    RESTORE_DB=$restore_db

    if [ "$kind" = full ]; then
        tar -xOf "$file" database-extras.sql >"$extras" 2>/dev/null || : >"$extras"
    fi
    if [ ! -s "$extras" ]; then
        # A plain dump: take them from the current database.
        dump_extras '' >"$extras" || die 'Could not read the search tokenizers of the current database.'
    fi
    run_step 'Restoring the database next to the current one (Chatvia keeps running)' \
        restore_database "$file" "$kind" "$restore_db" "$extras" ||
        die 'The restore failed. Your current data was not touched.'

    check_restored_version "$restore_db"
    RESTORED_STORAGE=$(embedding_storage_in "$restore_db" 2>>"$LOG") || RESTORED_STORAGE=''

    # shellcheck disable=SC2086 # a list of service names
    run_step 'Stopping Chatvia' compose stop $DATABASE_USERS || die 'Chatvia did not stop.'
    # From here on the restored database is the one to keep, even when the
    # switch fails half way.
    RESTORE_DB=''
    run_step 'Switching to the restored database' swap_database "$db" "$restore_db" ||
        die 'Could not switch to the restored database.' \
            "The restored data is in the database $restore_db. Your data from before is in" \
            "$(pretty_path "${BACKUP_FILE:-your backup}")."
    use_restored_storage

    case " $holds " in
        *' files '*)
            run_step 'Restoring the uploaded files' from_member "$file" files.tar restore_files ||
                die 'The uploaded files were not restored.' "The database is restored. Try the files again, or restore $(pretty_path "${BACKUP_FILE:-the backup}")."
            ;;
    esac
    case " $holds " in
        *' secrets '*) restore_secrets "$file" ;;
    esac

    case " $holds " in
        *' redis '*)
            if run_step 'Restoring Redis: sign-ins and chat memory' restore_redis_from "$file"; then
                run_step 'Emptying the queues and the cache' clear_queues_and_cache || true
            else
                warn 'Redis was not restored, so everyone signs in again.'
                run_step 'Emptying Redis' compose exec -T redis redis-cli FLUSHALL || true
            fi
            ;;
        *)
            # Sign-ins and queued jobs of the current data do not fit the
            # restored database.
            run_step 'Emptying Redis: queues, cache and sign-ins' compose exec -T redis redis-cli FLUSHALL || true
            ;;
    esac
    run_step 'Starting Chatvia (the database is updated first)' compose up -d --remove-orphans || start_failed
    run_step 'Waiting for the web app' wait_until 180 app_is_up ||
        die 'The web app did not answer within 3 minutes.' 'See why: ./manage status, then ./manage logs app'
}

# restore_database FILE KIND NEW_DB EXTRAS: restores into a new database, so
# the current one stays as it is until the restore has worked.
restore_database() {
    local file=$1 kind=$2 new_db=$3 extras=$4
    local owner
    owner=$(sql_value 'SELECT current_user') || return
    printf 'DROP DATABASE IF EXISTS :"db" WITH (FORCE);\nCREATE DATABASE :"db" OWNER :"owner";\n' |
        psql_in postgres -v db="$new_db" -v owner="$owner" || return
    if [ "$kind" = full ]; then
        tar -xOf "$file" database.dump | restore_dump "$new_db" || return
    else
        restore_dump "$new_db" <"$file" || return
    fi
    psql_in "$new_db" -v dbname="$new_db" <"$extras"
}

restore_dump() {
    compose exec -T postgres sh -c \
        'exec pg_restore -U "$POSTGRES_USER" -d "$1" --no-owner --no-privileges --exit-on-error --single-transaction' \
        sh "$1"
}

swap_database() {
    printf 'DROP DATABASE :"db" WITH (FORCE);\nALTER DATABASE :"new_db" RENAME TO :"db";\n' |
        psql_in postgres -v db="$1" -v new_db="$2"
}

drop_restore_database() {
    printf 'DROP DATABASE IF EXISTS :"db" WITH (FORCE);\n' | psql_in postgres -v db="$1" >>"$LOG" 2>&1 || true
}

# A backup from a newer Chatvia has tables this version does not know.
check_restored_version() {
    local restored known
    restored=$(latest_migration_in "$1" 2>>"$LOG") || restored=''
    known=$(latest_migration_known 2>>"$LOG") || known=''
    if [ -z "$restored" ] || [ -z "$known" ] || [[ ! $restored > $known ]]; then return 0; fi
    warn 'This backup comes from a newer version of Chatvia than this one.'
    info "$(dim "Upgrade first (./manage upgrade), then restore it.")"
    if [ "$INTERACTIVE" = 0 ] || ! confirm 'Restore it anyway?' n; then
        drop_restore_database "$1"
        die 'Nothing was changed.'
    fi
}

# The embedding settings in .env must match the restored tables, or the app
# refuses to start (app:check-embedding-storage).
use_restored_storage() {
    local storage=$RESTORED_STORAGE type size current_type current_size
    [ -n "$storage" ] || return 0
    type=${storage% *} size=${storage#* }
    current_type=$(env_value EMBEDDING_VECTOR_TYPE)
    current_size=$(env_value EMBEDDING_DIMENSIONS)
    if [ "$type" = "${current_type:-halfvec}" ] && [ "$size" = "${current_size:-1024}" ]; then return 0; fi
    set_env_value EMBEDDING_VECTOR_TYPE "$type"
    set_env_value EMBEDDING_DIMENSIONS "$size"
    ok "Search storage set to $type, $size dimensions in .env $(dim '(as in the backup)')"
}

# Puts the backup's secrets in place, but keeps this install's database
# password: PostgreSQL only reads it when it creates its data.
restore_secrets() {
    local file=$1 current new password_line
    current=$(read_secrets 2>>"$LOG") || die 'Could not read the current secrets.'
    new=$(tar -xOf "$file" secrets.env) || die 'Could not read the secrets in the backup.'
    password_line=$(printf '%s\n' "$current" | sed -n 's/^DB_PASSWORD=/&/p' | tail -n 1)
    new=$(printf '%s\n' "$new" | sed '/^DB_PASSWORD=/d')
    if [ "$(printf '%s\n' "$current" | sed '/^DB_PASSWORD=/d')" = "$new" ]; then
        ok 'The app key is the same as before'
        return
    fi
    if [ -n "$password_line" ]; then
        new=$(printf '%s\n# The database password of this install, kept by ./manage restore.\n%s' "$new" "$password_line")
    fi
    run_step 'Restoring the app key and the other secrets' from_text "$new" write_secrets ||
        die 'The secrets were not restored.' 'The database is restored, but values encrypted with the old app key cannot be read yet.'
}

