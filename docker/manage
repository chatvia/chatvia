#------------------------------------------------------------------------------
# Upgrade and rollback
#
# .env names one exact version (CHATVIA_VERSION=1.4.2). An upgrade looks up
# the new one, backs up, and lets the newest installer switch to it: the
# installer downloads everything first, then changes compose.yaml, this tool
# and .env, and starts the new version (the database is updated before it
# serves requests). A rollback gets the older version ready the same way
# (--no-start) and restores the backup from before the upgrade.
#------------------------------------------------------------------------------

cmd_upgrade() {
    local safety=1 spec='' no_pull=0
    while [ $# -gt 0 ]; do
        case $1 in
            --version)
                spec=${2:-}
                [ -n "$spec" ] || die '--version needs a version, like --version 1.4.2.'
                shift
                ;;
            --no-backup) safety=0 ;;
            --no-pull) no_pull=1 ;;
            --yes | -y) YES=1 INTERACTIVE=0 ;;
            *) die "Unknown option: $1" 'See ./manage help upgrade' ;;
        esac
        shift
    done

    intro 'Upgrade' "$(pretty_path "$DIR")"
    check_docker
    lock

    local current target app_before notes=''
    current=$(installed_version)
    FOUND_SOURCE=''
    if [ "$no_pull" = 1 ]; then
        # A local build: there is nothing to download or look up.
        target=${spec:-${current:-latest}}
    else
        find_version "${spec:-latest}"
        target=$FOUND_VERSION
        if [ "$target" = "$current" ]; then
            if [ -z "$spec" ]; then
                outro "Chatvia $current is the newest version. Nothing to do."
            else
                outro "Chatvia $current is already installed. Nothing to do."
            fi
            return
        fi
    fi
    if is_exact_version "$current" && is_exact_version "$target" && ! version_at_least "$target" "$current"; then
        die "Version $target is older than the one you run ($current)." \
            'Going back needs the data from before the upgrade: ./manage rollback'
    fi

    local row_version row_notes='' row_first
    kv_to row_version 'Version' "${current:-unknown} $S_ARROW $(accent "$target")"
    case $FOUND_SOURCE in
        https://github.com/*) notes="${FOUND_SOURCE%/}/releases/tag/v$target" ;;
    esac
    if [ -n "$notes" ]; then kv_to row_notes 'Release notes' "$notes"; fi
    if [ "$safety" = 1 ]; then
        kv_to row_first 'First' 'a backup of the database, the app key and Redis'
    else
        kv_to row_first 'First' "${C_YELLOW}no backup$C_RESET$(dim ' (--no-backup)')"
    fi
    note 'Upgrade' "$row_version" ${row_notes:+"$row_notes"} "$row_first"
    if is_exact_version "$current" && [ "${current%%.*}" != "${target%%.*}" ]; then
        warn 'A new major version: read the release notes before you upgrade.'
    fi
    if [ "$INTERACTIVE" = 1 ] && ! confirm "Upgrade to $target now?" y; then
        outro 'Nothing was changed.'
        return
    fi

    if [ "$safety" = 1 ]; then
        section 'Backup'
        do_backup 0 1 1 before-upgrade
        ok "Saved $(dim "$(pretty_path "$BACKUP_FILE")")"
    fi

    app_before=$(service_image app)
    local args=(--upgrade --version "$target")
    if [ "$no_pull" = 1 ]; then args+=(--no-pull); fi
    if [ "$INTERACTIVE" = 0 ]; then args+=(--yes); fi
    if ! run_installer "${args[@]}"; then
        upgrade_failed "$current" "$target"
    fi

    intro 'Versions'
    info "$(printf '%-12s' Chatvia)$(version_change "$app_before" "$(service_image app)")"
    remove_old_images "$current"
    outro "$(dim 'Something wrong? Go back: ./manage rollback')"
}

# installed_version: the version this install runs. .env names it; an
# install from before that has the version label of its running image. A
# local build keeps its own tag (like dev). Empty when unknown.
installed_version() {
    local version running
    version=$(env_value CHATVIA_VERSION)
    running=$(app_version)
    if is_exact_version "$version"; then
        printf '%s' "$version"
    elif is_exact_version "$running"; then
        printf '%s' "$running"
    elif [ "$version" != latest ]; then
        printf '%s' "$version"
    fi
    return 0
}

image_name() {
    local name
    name=$(env_value CHATVIA_IMAGE)
    printf '%s' "${name:-$DEFAULT_IMAGE}"
}

# find_version SPEC: downloads the image of a version (latest, 1.4 or 1.4.2)
# before anything stops. FOUND_VERSION is the release it is (its version
# label), FOUND_SOURCE the repository it was built from.
find_version() {
    local spec=$1 ref labels what="version $1"
    ref="$(image_name):$spec"
    if [ "$spec" = latest ]; then what='the newest version'; fi
    run_step "Getting $what" docker_cmd pull "$ref" ||
        die "Could not download $ref." 'Check the version and the internet connection.'
    labels=$(docker_cmd image inspect --format \
        '{{index .Config.Labels "org.opencontainers.image.source"}}|{{index .Config.Labels "org.opencontainers.image.version"}}' \
        "$ref" 2>/dev/null) || labels='|'
    FOUND_SOURCE=${labels%%|*}
    FOUND_VERSION=${labels#*|}
    if is_exact_version "$spec"; then FOUND_VERSION=$spec; fi
    if ! is_exact_version "$FOUND_VERSION"; then
        die "The image $ref does not say which version it is." 'Name the version: ./manage upgrade --version 1.4.2'
    fi
}

# run_installer ARGS...: the newest installer, on this folder. It shares this
# command's lock, and replaces compose.yaml and this tool (with a rename, so
# this run keeps reading its own copy).
run_installer() {
    local installer="$WORK_DIR/install.sh"
    run_step 'Downloading the installer' curl -fsSL "${CHATVIA_INSTALLER_URL:-$DEFAULT_INSTALLER_URL}" -o "$installer" ||
        die 'Could not download the installer.' "From: ${CHATVIA_INSTALLER_URL:-$DEFAULT_INSTALLER_URL}"
    outro 'The installer takes over.'
    keys_off
    bash "$installer" --dir "$DIR" "$@"
}

# upgrade_failed CURRENT TARGET: the installer stopped. Before it switched
# versions nothing changed; after, the new version did not start, and the
# backup made just before brings the old one back.
upgrade_failed() {
    local current=$1 target=$2
    intro 'Upgrade' "$(pretty_path "$DIR")"
    if [ "$(env_value CHATVIA_VERSION)" != "$target" ]; then
        die "The upgrade stopped before it changed anything.${current:+ Chatvia $current still runs.}"
    fi
    warn "Version $target did not start."
    if [ -z "$BACKUP_FILE" ] || ! is_exact_version "$current"; then
        die 'See why: ./manage logs migrate' \
            'To go back, restore a backup from before the upgrade: ./manage rollback FILE'
    fi
    info "The backup made just before the upgrade holds your data from version $current."
    if ! confirm "Go back to $current with that backup?" y; then
        die "Chatvia stays on version $target, which did not start." 'See why: ./manage logs migrate' \
            "Go back later: ./manage rollback ${BACKUP_FILE##*/}"
    fi
    do_rollback "$BACKUP_FILE" "$current" "$BACKUP_HOLDS"
    ok "$(bold "Back on version $current.")"
    outro "Chatvia is running at $(accent "$(app_url)"). The upgrade failed: see $(pretty_path "$DIR")/install.log"
    exit 1
}

cmd_rollback() {
    local file='' name='' safety=1 version current holds created
    while [ $# -gt 0 ]; do
        case $1 in
            --no-backup) safety=0 ;;
            --yes | -y) YES=1 INTERACTIVE=0 ;;
            -*) die "Unknown option: $1" 'See ./manage help rollback' ;;
            *) file=$1 name=$1 ;;
        esac
        shift
    done

    intro 'Roll back' "$(pretty_path "$DIR")"
    need_terminal 'A rollback replaces all data, so it asks first.'
    check_docker
    lock

    current=$(installed_version)
    if [ -z "$file" ]; then
        file=$(rollback_backup "$current") ||
            die "There is no backup from before an upgrade${current:+ to $current}." \
                'Name one: ./manage rollback FILE (see ./manage backups)'
    else
        file=$(resolve_backup "$file") || die "There is no backup called $name." 'List them: ./manage backups'
    fi
    version=$(backup_value "$file" VERSION)
    holds=$(backup_value "$file" HOLDS)
    created=$(backup_value "$file" CREATED)
    if ! is_exact_version "$version"; then
        die "$(pretty_path "$file") does not say which version of Chatvia made it." \
            "Restore it on the version you run: ./manage restore ${file##*/}"
    fi
    if [ "$version" = "$current" ]; then
        die "This backup comes from version $version, the one you run now." \
            "Restore it: ./manage restore ${file##*/}"
    fi
    if is_exact_version "$current" && version_at_least "$version" "$current"; then
        die "This backup comes from version $version, which is newer than this one ($current)." \
            "Upgrade first (./manage upgrade --version $version), then restore it."
    fi

    local row_version row_file row_made row_holds row_now
    kv_to row_version 'Version' "${current:-unknown} $S_ARROW $(accent "$version")"
    kv_to row_file 'Backup' "${file##*/}  $(dim "$(human_size "$(file_size "$file")")")"
    created=${created%Z}
    kv_to row_made 'Made' "${created/T/ } UTC"
    kv_to row_holds 'Holds' "$(describe_holds "$holds")"
    kv_to row_now 'Current data' "${C_YELLOW}replaced$C_RESET$(dim ', after a backup of it')"
    if [ "$safety" = 0 ]; then kv_to row_now 'Current data' "${C_YELLOW}replaced, with no backup of it$C_RESET"; fi
    note 'Roll back?' "$row_version" "$row_file" "$row_made" "$row_holds" "$row_now"
    info "$(dim 'Everything since this backup is replaced: new chats, settings and sources.')"
    if [ "$INTERACTIVE" = 1 ] && ! confirm "Go back to $version and replace all data with this backup?" n; then
        outro 'Nothing was changed.'
        return
    fi

    if [ "$safety" = 1 ]; then
        section 'Backup of the current data'
        do_backup 0 1 1 before-rollback
        ok "Saved $(dim "$(pretty_path "$BACKUP_FILE")")"
    fi
    do_rollback "$file" "$version" "$holds"
    ok "$(bold "Back on version $version.")"
    outro "Chatvia is running at $(accent "$(app_url)")"
}

# rollback_backup CURRENT: the newest backup made before an upgrade, from a
# version older than CURRENT. A failed upgrade also leaves one, of CURRENT
# itself, which this skips.
rollback_backup() {
    local file version
    while IFS= read -r file; do
        version=$(backup_value "$file" VERSION)
        is_exact_version "$version" || continue
        if is_exact_version "$1" && version_at_least "$version" "$1"; then continue; fi
        printf '%s' "$file"
        return 0
    done < <(list_backups | grep -e '-before-upgrade\.tar$' | sort -r)
    return 1
}

# do_rollback FILE VERSION HOLDS: the installer gets the older version ready
# without starting it, then the restore replaces the data and starts it. An
# image still on this machine is used as it is (no download).
do_rollback() {
    local file=$1 version=$2 holds=$3 args=(--upgrade --version "$2" --no-start)
    if docker_cmd image inspect "$(image_name):$version" >/dev/null 2>&1; then args+=(--no-pull); fi
    if [ "$INTERACTIVE" = 0 ]; then args+=(--yes); fi
    run_installer "${args[@]}" ||
        die "Could not get version $version ready. Your data was not touched." \
            "See why: $(pretty_path "$DIR")/install.log"
    intro 'Restore' "$(pretty_path "$DIR")"
    restore_backup "$file" full "$holds"
}

# remove_old_images REPLACED: deletes the app images of versions older than
# REPLACED (the version an upgrade replaced, which stays, so a rollback needs
# no download), and the Chatvia images that lost their name when a newer one
# was downloaded. An image that a container still uses is kept.
remove_old_images() {
    local replaced=$1 name tag id source removed=0
    name=$(image_name)
    while IFS= read -r tag; do
        if ! is_exact_version "$tag" || ! is_exact_version "$replaced"; then continue; fi
        if version_at_least "$tag" "$replaced"; then continue; fi
        if docker_cmd image rm "$name:$tag" >>"$LOG" 2>&1; then removed=$((removed + 1)); fi
    done < <(docker_cmd image ls --format '{{.Tag}}' "$name" 2>/dev/null)
    while IFS= read -r id; do
        source=$(docker_cmd image inspect --format '{{index .Config.Labels "org.opencontainers.image.source"}}' "$id" 2>/dev/null) ||
            continue
        case $source in *github.com/chatvia/*) ;; *) continue ;; esac
        if docker_cmd image rm "$id" >>"$LOG" 2>&1; then removed=$((removed + 1)); fi
    done < <(docker_cmd image ls --quiet --filter dangling=true 2>/dev/null)
    if [ "$removed" -gt 0 ]; then ok "Deleted $removed old image(s)"; fi
}

# service_image SERVICE: "<image id>|<version>" of what the service runs. The
# version is the image's version label when the image comes from a Chatvia
# repository (a local build inherits its base image's label), else the
# image's short id.
service_image() {
    local id image labels
    id=$(compose ps -q "$1" 2>/dev/null | head -n 1) || id=''
    [ -n "$id" ] || return 0
    image=$(docker_cmd inspect --format '{{.Image}}' "$id" 2>/dev/null) || return 0
    labels=$(docker_cmd image inspect --format \
        '{{index .Config.Labels "org.opencontainers.image.source"}}|{{index .Config.Labels "org.opencontainers.image.version"}}' \
        "$image" 2>/dev/null) || labels=''
    case $labels in
        *chatvia/*'|'?*) printf '%s|%s' "$image" "${labels#*|}" ;;
        *)
            image=${image#sha256:}
            printf '%s|image %s' "$image" "${image:0:12}"
            ;;
    esac
}

# version_change BEFORE AFTER: "1.4.2 → 1.5.0", or "1.5.0, no change".
version_change() {
    local before=$1 after=$2
    if [ -z "$after" ]; then
        printf '%s' 'not running'
    elif [ "${before%%|*}" = "${after%%|*}" ]; then
        printf '%s' "${after#*|}$(dim ', no change')"
    elif [ -z "$before" ]; then
        printf '%s' "${after#*|}"
    else
        printf '%s' "${before#*|} $S_ARROW $(accent "${after#*|}")"
    fi
}

cmd_postgres() {
    local action=${1:-}
    if [ $# -gt 0 ]; then shift; fi
    case $action in
        tune) postgres_tune "$@" ;;
        edit) postgres_edit "$@" ;;
        apply) postgres_apply "$@" ;;
        export) postgres_export "$@" ;;
        '' | help | -h | --help) command_help postgres ;;
        *) die "Unknown: ./manage postgres $action" 'Use tune, edit, apply or export.' ;;
    esac
}

pg_conf() {
    printf '%s' "$DIR/postgres/postgresql.conf"
}

postgres_export() {
    local if_missing=0
    while [ $# -gt 0 ]; do
        case $1 in
            --if-missing) if_missing=1 ;;
            --yes | -y) YES=1 INTERACTIVE=0 ;;
            *) die "Unknown option: $1" 'See ./manage help postgres' ;;
        esac
        shift
    done

    intro 'PostgreSQL settings' "$(pretty_path "$DIR")"
    check_docker
    lock
    if [ -f "$(pg_conf)" ]; then
        if [ "$if_missing" = 1 ]; then
            outro "$(pretty_path "$(pg_conf)") is already there."
            return
        fi
        warn "$(pretty_path "$(pg_conf)") is already there."
        info "$(dim 'Exporting again starts over from the default settings. Your file is kept as a copy.')"
        if ! confirm 'Start over from the default settings?' n; then
            outro 'Nothing was changed.'
            return
        fi
    fi

    ensure_postgres
    run_step 'Exporting the settings from the database container' export_postgres_config ||
        die 'The settings were not exported.'
    ok "Saved $(dim "$(pretty_path "$(pg_conf)")")"
    ensure_override
    apply_postgres_settings
    outro "Change it any time, then run $(accent './manage postgres apply')"
}

postgres_apply() {
    no_options "$@"
    intro 'PostgreSQL settings' "$(pretty_path "$DIR")"
    check_docker
    lock
    [ -f "$(pg_conf)" ] || die "There is no $(pretty_path "$(pg_conf)") yet." 'Create it: ./manage postgres export'
    ensure_override
    apply_postgres_settings
    outro 'Done.'
}

postgres_edit() {
    no_options "$@"
    intro 'PostgreSQL settings' "$(pretty_path "$DIR")"
    check_docker
    lock
    if [ ! -f "$(pg_conf)" ]; then
        ensure_postgres
        run_step 'Exporting the settings from the database container' export_postgres_config ||
            die 'The settings were not exported.'
        ensure_override
    fi

    local editor=${VISUAL:-${EDITOR:-}} before after
    if [ -z "$editor" ]; then
        if command -v nano >/dev/null 2>&1; then editor='nano'; else editor='vi'; fi
    fi
    before=$(cksum <"$(pg_conf)")
    info "$(dim "Opening $(pretty_path "$(pg_conf)") in $editor")"
    keys_off
    # Unquoted: the editor may come with options, like "code --wait".
    # shellcheck disable=SC2086
    $editor "$(pg_conf)" </dev/tty >/dev/tty
    after=$(cksum <"$(pg_conf)")
    if [ "$before" = "$after" ] && postgres_uses_file; then
        outro 'No changes.'
        return
    fi
    apply_postgres_settings
    outro 'Done.'
}

postgres_tune() {
    no_options "$@"
    intro 'PostgreSQL tuning' "$(pretty_path "$DIR")"
    check_docker
    lock
    if [ ! -f "$(pg_conf)" ]; then
        ensure_postgres
        run_step 'Exporting the settings from the database container' export_postgres_config ||
            die 'The settings were not exported.'
    fi
    ensure_override
    ensure_postgres
    detect_postgres_resources
    local processors=processors
    if [ "$TUNE_CPUS" = 1 ]; then processors=processor; fi
    ok "PostgreSQL gets $(bold "$(human_size $((TUNE_RAM_MB * 1048576)))") of memory and $(bold "$TUNE_CPUS") $processors $(dim "($TUNE_SOURCE)")"

    local connections settings
    connections=$(sql_value 'SHOW max_connections' 2>/dev/null) || connections=''
    case $connections in '' | *[!0-9]* | 0) connections=100 ;; esac
    settings=$(pg_tune_settings "$TUNE_RAM_MB" "$TUNE_CPUS" "$connections")

    # What the server runs with now, next to what the tune computed.
    local in_list='' name value current before changes=0
    while read -r name value; do
        in_list="$in_list${in_list:+,}'$name'"
    done <<<"$settings"
    current=$(sql_value "SELECT name || ' ' || current_setting(name) FROM pg_settings WHERE name IN ($in_list)") ||
        current=''
    section 'The settings for that' "with $connections connections, on SSD storage"
    while read -r name value; do
        before=$(awk -v n="$name" '$1 == n { print $2 }' <<<"$current")
        if [ "$before" = "$value" ]; then
            info "$(printf '%-33s' "$name") $(dim "$value, no change")"
        else
            info "$(printf '%-33s' "$name") ${before:-?} $S_ARROW $(accent "$value")"
            changes=$((changes + 1))
        fi
    done <<<"$settings"
    tune_shm_warning

    if [ "$changes" -eq 0 ] && [ "$(written_tune_settings)" = "$settings" ]; then
        outro 'Already tuned. Run it again when the memory or processors change.'
        return
    fi
    if ! confirm 'Write these settings to postgres/postgresql.conf and apply them?' y; then
        outro 'Nothing was changed.'
        return
    fi
    if [ "$(written_tune_settings)" != "$settings" ]; then
        write_tune_block "$settings" || die 'The settings were not written.'
        ok "Saved $(dim "$(pretty_path "$(pg_conf)")")"
    fi
    apply_postgres_settings
    outro 'Done. Run it again when the memory or processors change.'
}

# The memory and processors PostgreSQL actually gets: its container's cgroup
# limits when one is set, else the machine the containers run on (on macOS
# and Windows that is Docker's own virtual machine). Sets TUNE_RAM_MB,
# TUNE_CPUS and TUNE_SOURCE.
detect_postgres_resources() {
    local bytes kb quota period
    TUNE_RAM_MB='' TUNE_CPUS='' TUNE_SOURCE='the machine the containers run on'

    # cgroup v2, then v1; "max" or an enormous number means no limit.
    bytes=$(compose exec -T postgres sh -c \
        'cat /sys/fs/cgroup/memory.max 2>/dev/null || cat /sys/fs/cgroup/memory/memory.limit_in_bytes 2>/dev/null' |
        tr -d '[:space:]') || bytes=''
    if [[ $bytes =~ ^[0-9]+$ ]] && [ "$bytes" -lt 4611686018427387904 ]; then
        TUNE_RAM_MB=$((bytes / 1048576))
        TUNE_SOURCE='a memory limit on the container'
    else
        kb=$(compose exec -T postgres awk '/^MemTotal:/ { print $2 }' /proc/meminfo | tr -d '[:space:]') || kb=''
        if [[ $kb =~ ^[0-9]+$ ]]; then TUNE_RAM_MB=$((kb / 1024)); fi
    fi
    if [ -z "$TUNE_RAM_MB" ] || [ "$TUNE_RAM_MB" -eq 0 ]; then
        if [ "$OS" = macos ]; then
            TUNE_RAM_MB=$(($(sysctl -n hw.memsize 2>/dev/null || echo 0) / 1048576))
        else
            TUNE_RAM_MB=$(($(awk '/^MemTotal:/ { print $2 }' /proc/meminfo 2>/dev/null || echo 0) / 1024))
        fi
        TUNE_SOURCE='this machine'
    fi
    [ "$TUNE_RAM_MB" -gt 0 ] || die 'Could not read how much memory PostgreSQL gets.' \
        'Tune by hand: ./manage postgres edit'

    # A CPU quota ("150000 100000" means 1.5, so 2 processors), else the
    # processors the container sees.
    quota=$(compose exec -T postgres sh -c '
        if [ -f /sys/fs/cgroup/cpu.max ]; then
            cat /sys/fs/cgroup/cpu.max
        elif [ -f /sys/fs/cgroup/cpu/cpu.cfs_quota_us ]; then
            echo "$(cat /sys/fs/cgroup/cpu/cpu.cfs_quota_us) $(cat /sys/fs/cgroup/cpu/cpu.cfs_period_us)"
        fi' | tr -s '[:space:]' ' ') || quota=''
    quota=${quota# }
    quota=${quota% }
    period=${quota#* }
    quota=${quota%% *}
    if [[ $quota =~ ^[0-9]+$ ]] && [[ $period =~ ^[0-9]+$ ]] && [ "$period" -gt 0 ]; then
        TUNE_CPUS=$(((quota + period - 1) / period))
    else
        TUNE_CPUS=$(compose exec -T postgres nproc | tr -d '[:space:]') || TUNE_CPUS=''
    fi
    if ! [[ $TUNE_CPUS =~ ^[0-9]+$ ]] || [ "$TUNE_CPUS" -eq 0 ]; then
        if [ "$OS" = macos ]; then
            TUNE_CPUS=$(sysctl -n hw.ncpu 2>/dev/null) || TUNE_CPUS=1
        else
            TUNE_CPUS=$(nproc 2>/dev/null) || TUNE_CPUS=1
        fi
    fi
    case $TUNE_CPUS in '' | *[!0-9]* | 0) TUNE_CPUS=1 ;; esac
}

# The tuned PostgreSQL settings for the memory, processors and connections it
# gets: pgtune's numbers for a web application on SSD storage, as one
# "name value" line each. install.sh carries the same function for the
# complete installation (the two files are shipped apart): change it there too.
# pg_tune_settings RAM_MB PROCESSORS MAX_CONNECTIONS
pg_tune_settings() {
    local ram_mb=$1 cpus=$2 connections=$3
    local shared_mb cache_mb maintenance_mb gather work_kb wal_kb pair name kb

    # A quarter of the memory for PostgreSQL's own cache (at most 8 GB), and
    # three quarters as the planner's guess of what the OS caches on top.
    shared_mb=$((ram_mb / 4))
    if [ "$shared_mb" -gt 8192 ]; then shared_mb=8192; fi
    cache_mb=$((ram_mb * 3 / 4))

    # Index builds work in maintenance_work_mem: the search indexes
    # (VectorChord, bm25) build much faster with room here.
    maintenance_mb=$((ram_mb / 16))
    if [ "$maintenance_mb" -gt 2048 ]; then maintenance_mb=2048; fi

    # Up to half the processors (at most 4) may serve one query together.
    gather=$(((cpus + 1) / 2))
    if [ "$gather" -gt 4 ]; then gather=4; fi

    # The memory left after shared_buffers, shared over every connection
    # running up to 3 sorts, each over its parallel workers. At least 64 kB.
    work_kb=$(((ram_mb - shared_mb) * 1024 / (connections * 3) / gather))
    if [ "$work_kb" -lt 64 ]; then work_kb=64; fi

    # 3% of shared_buffers for the WAL, at most 16 MB (14 MB and up rounds
    # to the usual 16 MB; wal_buffers counts in blocks of 8 kB).
    wal_kb=$((shared_mb * 1024 * 3 / 100 / 8 * 8))
    if [ "$wal_kb" -ge 14336 ]; then wal_kb=16384; fi

    # Sizes print the way PostgreSQL shows them back (the largest whole
    # unit), so a second run can see that nothing changed.
    for pair in "shared_buffers $((shared_mb * 1024))" \
        "effective_cache_size $((cache_mb * 1024))" \
        "maintenance_work_mem $((maintenance_mb * 1024))" \
        "work_mem $work_kb" \
        "wal_buffers $wal_kb"; do
        name=${pair% *} kb=${pair#* }
        if [ $((kb % 1048576)) -eq 0 ]; then
            printf '%s %sGB\n' "$name" $((kb / 1048576))
        elif [ $((kb % 1024)) -eq 0 ]; then
            printf '%s %sMB\n' "$name" $((kb / 1024))
        else
            printf '%s %skB\n' "$name" "$kb"
        fi
    done
    printf 'min_wal_size 1GB\n'
    printf 'max_wal_size 4GB\n'
    # Spread each checkpoint's writes out, and tell the planner this is an
    # SSD: random reads cost little, and many can be in flight.
    printf 'checkpoint_completion_target 0.9\n'
    printf 'random_page_cost 1.1\n'
    printf 'effective_io_concurrency 200\n'
    # Worker slots, never below PostgreSQL's default of 8: extensions take
    # slots here too. How many actually run in parallel follows the
    # processors.
    printf 'max_worker_processes %s\n' $((cpus > 8 ? cpus : 8))
    printf 'max_parallel_workers_per_gather %s\n' "$gather"
    printf 'max_parallel_workers %s\n' "$cpus"
    printf 'max_parallel_maintenance_workers %s\n' "$gather"
}

# The tune lines now in postgres/postgresql.conf, as "name value" lines.
written_tune_settings() {
    sed -n "s/^\([a-z_]*\) = '\(.*\)'[[:space:]]*# set by Chatvia tune\$/\1 \2/p" "$(pg_conf)"
}

# shared_buffers must fit in the container's shared memory (shm_size in
# compose.yaml), where parallel queries put what they share.
tune_shm_warning() {
    local shm shared_mb
    shared_mb=$((TUNE_RAM_MB / 4))
    if [ "$shared_mb" -gt 8192 ]; then shared_mb=8192; fi
    shm=$(docker_cmd inspect --format '{{.HostConfig.ShmSize}}' "$(compose ps -q postgres)" 2>/dev/null) || shm=''
    case $shm in '' | *[!0-9]* | 0) return 0 ;; esac
    if [ $((shared_mb * 1048576)) -le "$shm" ]; then return 0; fi
    warn "shared_buffers is more than the container's shared memory ($(human_size "$shm"))."
    info "Big parallel queries may fail for lack of it. Give the container more: set"
    info "$(accent "shm_size: $(((shared_mb + 1023) / 1024))gb") on postgres in $(pretty_path "$DIR/compose.override.yaml") (there is"
    info "a hint at the end of its postgres block), then ./manage restart postgres."
}

# Writes the tune block at the end of postgres/postgresql.conf: an earlier
# block goes, every other line stays. PostgreSQL takes the last value it
# reads, so the block wins over the same names above it.
write_tune_block() {
    local conf tmp name value
    conf=$(pg_conf)
    tmp=$(mktemp "$DIR/postgres/.postgresql.conf.XXXXXX") || return
    {
        awk '
            /^# Chatvia tune begin/ { skip = 1 }
            skip { if (/^# Chatvia tune end/) skip = 0; next }
            /# set by Chatvia tune$/ { next }
            { line[++n] = $0 }
            END {
                while (n > 0 && line[n] == "") n--
                for (i = 1; i <= n; i++) print line[i]
            }
        ' "$conf"
        printf '\n# Chatvia tune begin: written by ./manage postgres tune on %s, for\n' "$(date '+%Y-%m-%d')"
        printf '# %s of memory and %s processors. These lines win over the same\n' \
            "$(human_size $((TUNE_RAM_MB * 1048576)))" "$TUNE_CPUS"
        printf '# settings above them; your own lines are never touched. Run the tune again\n'
        printf '# when the memory or processors change.\n'
        while read -r name value; do
            printf "%s = '%s'\t# set by Chatvia tune\n" "$name" "$value"
        done <<<"$1"
        printf '# Chatvia tune end\n'
    } >"$tmp" || {
        rm -f "$tmp"
        return 1
    }
    # A failed rewrite must not lose the file.
    if ! grep -q 'PostgreSQL configuration file' "$tmp"; then
        rm -f "$tmp"
        echo 'The rewritten postgresql.conf is incomplete.' >&2
        return 1
    fi
    chmod 644 "$tmp" && mv "$tmp" "$conf"
}

# Writes postgres/postgresql.conf: the file PostgreSQL made when it created
# its data, plus the settings the image passes on its command line (the
# search libraries), so the file alone holds every setting.
export_postgres_config() {
    local dir="$DIR/postgres" conf tmp image words word next=0 names='' values=''
    conf=$(pg_conf)
    mkdir -p "$dir" && chmod 755 "$dir" || return
    if [ -f "$conf" ]; then cp -p "$conf" "$conf.$(date '+%Y%m%d-%H%M%S').bak" || return; fi

    # The image's command, one word per line: postgres -c name=value ...
    image=$(docker_cmd inspect --format '{{.Config.Image}}' "$(compose ps -q postgres)") || return
    words=$(docker_cmd image inspect --format '{{range .Config.Cmd}}{{println .}}{{end}}' "$image") || return
    while IFS= read -r word; do
        if [ "$next" = 1 ] && [[ $word == *=* ]]; then
            names="$names${word%%=*}"$'\n'
            values="$values${word#*=}"$'\n'
        fi
        next=0
        if [ "$word" = -c ]; then next=1; fi
    done <<<"$words"

    tmp=$(mktemp "$dir/.postgresql.conf.XXXXXX") || return
    {
        cat <<HEADER
# PostgreSQL settings of this Chatvia install, exported from the database
# container on $(date '+%Y-%m-%d'). Change what you need, then run:
#
#   ./manage postgres apply
#
# It checks this file, reloads PostgreSQL, and restarts it when a changed
# setting needs that (they say "change requires restart" below).
#
# Chatvia's search needs vchord, vchord_bm25, vector and pg_tokenizer in
# shared_preload_libraries: add your own libraries after them.
#
# ./manage postgres export starts over from the defaults. Every setting:
# https://www.postgresql.org/docs/current/runtime-config.html

HEADER
        # The lists go through the environment: awk -v takes no newlines.
        compose exec -T postgres sh -c 'cat "$PGDATA/postgresql.conf"' |
            NAMES=$names VALUES=$values awk '
                BEGIN {
                    n = split(ENVIRON["NAMES"], name, "\n")
                    split(ENVIRON["VALUES"], value, "\n")
                }
                {
                    for (i = 1; i < n; i++) {
                        if (!done[i] && $0 ~ "^#?[ \t]*" name[i] "[ \t]*=") {
                            print name[i] " = '\''" value[i] "'\''\t# set by Chatvia"
                            done[i] = 1
                            next
                        }
                    }
                    print
                }
                END {
                    for (i = 1; i < n; i++) {
                        if (!done[i]) print name[i] " = '\''" value[i] "'\''\t# set by Chatvia"
                    }
                }'
    } >"$tmp" || {
        rm -f "$tmp"
        return 1
    }
    # A cut-off copy has no "PostgreSQL configuration file" heading.
    if ! grep -q 'PostgreSQL configuration file' "$tmp"; then
        rm -f "$tmp"
        echo 'The copy of postgresql.conf is incomplete.' >&2
        return 1
    fi
    # PostgreSQL runs as another user in its container.
    chmod 644 "$tmp" && mv "$tmp" "$conf"
}

# compose.override.yaml mounts postgres/ and points PostgreSQL at the file.
ensure_override() {
    local override="$DIR/compose.override.yaml"
    if [ -f "$override" ]; then
        if grep -q "config_file=$PG_CONF_MOUNT/postgresql.conf" "$override"; then return 0; fi
        warn "$(pretty_path "$override") is yours, so it was not changed. Add this to it:"
        override_snippet | quote
        die 'Then run ./manage postgres apply.'
    fi
    {
        cat <<'HEADER'
# Your changes to compose.yaml. Docker Compose reads this file after it, and
# upgrades never touch it, so changes here are kept. After a change, run:
#
#   ./manage restart

services:
HEADER
        override_snippet
    } >"$override"
    ok "Saved $(dim "$(pretty_path "$override")")"
}

override_snippet() {
    cat <<SNIPPET
  # PostgreSQL reads its settings from postgres/postgresql.conf, next to this
  # file. Change it, then run ./manage postgres apply.
  postgres:
    command: ["postgres", "-c", "config_file=$PG_CONF_MOUNT/postgresql.conf"]
    volumes:
      - ./postgres:$PG_CONF_MOUNT:ro
    # More shared memory, for many parallel workers:
    # shm_size: 1gb
SNIPPET
}

# The running server reads our file.
postgres_uses_file() {
    [ "$(sql_value 'SHOW config_file' 2>/dev/null)" = "$PG_CONF_MOUNT/postgresql.conf" ]
}

# Checks the file with PostgreSQL itself, in a container of its own:
# postgres -C reads the settings like a start does, and stops at the first
# error, without touching the running server. OUTPUT holds its answer.
check_postgres_config() {
    OUTPUT=$(compose run --rm --no-deps -T --user postgres postgres \
        postgres -c "config_file=$PG_CONF_MOUNT/postgresql.conf" -C shared_preload_libraries 2>&1)
}

# Applies postgres/postgresql.conf: checks it, then reloads PostgreSQL, or
# restarts it when it does not read the file yet or a changed setting needs
# a restart. An invalid file changes nothing.
apply_postgres_settings() {
    local libraries library missing='' pending
    OUTPUT=''
    if ! check_postgres_config; then
        fail 'postgres/postgresql.conf has errors:'
        printf '%s\n' "$OUTPUT" | sed -E -n 's/^.*(LOG|FATAL|HINT|DETAIL): +//p' | quote >&2
        die 'Fix them, then run ./manage postgres apply. PostgreSQL still runs with its old settings.'
    fi
    libraries=,$(printf '%s\n' "$OUTPUT" | tail -n 1 | tr -d ' "'),
    for library in $REQUIRED_LIBRARIES; do
        case $libraries in *",$library,"*) ;; *) missing="$missing $library" ;; esac
    done
    if [ -n "$missing" ]; then
        die "shared_preload_libraries misses what Chatvia's search needs:$missing" \
            'Put them back, then run ./manage postgres apply. PostgreSQL still runs with its old settings.'
    fi
    ok 'The settings file is valid'

    if ! is_running postgres; then
        info "$(dim 'PostgreSQL is stopped: it reads the file when it starts.')"
        return
    fi
    if ! postgres_uses_file; then
        if is_running app; then info "$(dim 'Chatvia pauses for a few seconds while PostgreSQL restarts.')"; fi
        run_step 'Restarting PostgreSQL with the settings file' compose up -d --no-deps --wait postgres ||
            postgres_start_failed
        postgres_uses_file || die 'PostgreSQL does not read postgres/postgresql.conf.' \
            "Check $(pretty_path "$DIR/compose.override.yaml")."
        ok 'Applied'
        return
    fi

    run_step 'Reloading the settings' sql_value 'SELECT pg_reload_conf()' || die 'PostgreSQL did not reload.'
    sleep 1
    pending=$(sql_value "SELECT string_agg(name, ', ' ORDER BY name) FROM pg_settings WHERE pending_restart") || pending=''
    if [ -z "$pending" ]; then
        ok 'Applied, no restart needed'
        return
    fi
    warn "These need a restart of PostgreSQL: $(bold "$pending")"
    if ! confirm 'Restart PostgreSQL now? Chatvia pauses for a few seconds.' y; then
        info "$(dim 'They apply on the next restart: ./manage restart postgres')"
        return
    fi
    run_step 'Restarting PostgreSQL' compose restart postgres || postgres_start_failed
    run_step 'Waiting for PostgreSQL' wait_until 120 postgres_is_ready || postgres_start_failed
    ok 'Applied'
}

postgres_start_failed() {
    section 'PostgreSQL log'
    compose logs --no-color --tail 20 postgres 2>&1 | quote >&2 || true
    die 'PostgreSQL did not start.' 'Fix postgres/postgresql.conf, then run ./manage postgres apply.'
}

cmd_uninstall() {
    while [ $# -gt 0 ]; do
        case $1 in
            --yes | -y) YES=1 INTERACTIVE=0 ;;
            *) die "Unknown option: $1" 'See ./manage help uninstall' ;;
        esac
        shift
    done

    intro 'Uninstall' "$(pretty_path "$DIR")"
    need_terminal 'Uninstalling deletes all data, so it asks first.'
    check_docker
    lock
    warn "$(bold 'This deletes Chatvia and ALL its data:') the database, the uploaded files,"
    info 'the app key, and the settings files in this folder.'
    info "$(dim "Backups in $(pretty_path "$(backup_dir)") are kept.")"

    if [ "$INTERACTIVE" = 1 ]; then
        if confirm 'Make a backup first (database, app key and files)?' y; then
            do_backup 1 1 1 before-uninstall
            ok "Saved $(dim "$(pretty_path "$BACKUP_FILE")")"
        fi
        # shellcheck disable=SC2034 # set by ask
        local typed
        ask typed 'Type delete to remove everything' --check valid_delete
    fi

    run_step 'Removing the containers and all data' compose down --volumes --remove-orphans ||
        die 'Could not remove everything.' 'See the log, then try again.'
    local file
    for file in compose.yaml compose.yaml.bak compose.override.yaml .env install.log; do
        rm -f "${DIR:?}/$file"
    done
    rm -rf "${DIR:?}/postgres"
    ok 'Removed the settings files'
    rm -f "${DIR:?}/manage" "$LOG"
    unlock
    rmdir "$DIR" 2>/dev/null || true
    outro 'Chatvia is uninstalled.'
}

no_options() {
    local arg
    for arg in "$@"; do
        case $arg in
            --yes | -y) ;;
            *) die "Unknown option: $arg" "See ./manage help $COMMAND" ;;
        esac
    done
}

