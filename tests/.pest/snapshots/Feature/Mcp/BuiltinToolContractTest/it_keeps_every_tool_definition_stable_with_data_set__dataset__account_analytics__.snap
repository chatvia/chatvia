    {
        "name": "get-activity-patterns-tool",
        "title": "Get Activity Patterns Tool",
        "description": "When visitors are active, for a period: conversations by hour of day (0–23, UTC)\nand by day of week, with the peak hour and busiest weekday called out. Answers\n\"when are people most active?\", \"what's my peak hour?\", \"which weekday is\nbusiest?\". The hourly and weekday series make a good bar or heatmap chart.",
        "inputSchema": {
            "properties": {
                "period": {
                    "description": "Time window. Defaults to \"this_month\". Use \"last_month\" for the one before, or a rolling window like \"last_7_days\"/\"last_30_days\".",
                    "default": "this_month",
                    "enum": [
                        "this_month",
                        "today",
