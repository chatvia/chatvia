{
  "name": "chat-widget",
  "version": "1.0.0",
  "description": "A customizable, embeddable chat widget with Markdown support",
  "main": "dist/chat-widget.bundle.min.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "NODE_ENV=production npm run clean && rollup -c rollup.config.js",
    "build:dev": "npm run clean && rollup -c rollup.config.js",
    "build:prod": "NODE_ENV=production npm run clean && rollup -c rollup.config.js",
    "clean": "rimraf dist && mkdir dist",
    "demo": "node serve-demo.js",
    "lint": "eslint \"src/**/*.js\"",
    "lint:fix": "eslint \"src/**/*.js\" --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "keywords": [
    "chat",
    "widget",
    "markdown",
    "sse"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-strip": "^3.0.4",
    "@rollup/plugin-terser": "^1.0.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "fs-extra": "^11.3.5",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "postcss-import": "^16.1.1",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "rollup": "^4.61.1",
    "rollup-plugin-gzip": "^4.2.0",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-visualizer": "^7.0.1",
    "vite": "^8.0.16",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-subresource-integrity": "^0.0.12",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "dompurify": "^3.4.8",
    "dotenv": "^17.4.2",
    "eslint-plugin-prettier": "^5.5.6",
    "pusher-js": "^8.5.0",
    "rollup-plugin-dotenv": "^0.5.1"
  }
}
