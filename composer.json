{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/vue-starter-kit",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-intl": "*",
        "ext-libxml": "*",
        "ext-pdo": "*",
        "ext-openssl": "*",
        "aws/aws-sdk-php": "^3.351",
        "cesargb/laravel-magiclink": "^2.24",
        "chatvia/laravel-prompt-manager": "dev-main",
        "coderflex/laravel-turnstile": "^2.1",
        "crwlr/crawler": "^3.5",
        "filament/filament": "^3.3",
        "firebase/php-jwt": "^6.11",
        "google/cloud-document-ai": "^2.2",
        "graham-campbell/markdown": "^16.0",
        "inertiajs/inertia-laravel": "^2.0",
        "intervention/image": "^3.11",
        "intervention/image-laravel": "^1.5",
        "james-heinrich/getid3": "^1.9",
        "laravel/cashier": "^15.6",
        "laravel/framework": "^12.0",
        "laravel/horizon": "^5.33",
        "laravel/nightwatch": "^1.11",
        "laravel/octane": "^2.9",
        "laravel/pennant": "^1.18",
        "laravel/pulse": "^1.4",
        "laravel/reverb": "^1.0",
        "laravel/sanctum": "^4.0",
        "laravel/slack-notification-channel": "^3.6",
        "laravel/socialite": "^5.23",
        "laravel/telescope": "^5.10",
        "laravel/tinker": "^2.10.1",
        "league/commonmark": "^2.7",
        "league/flysystem-aws-s3-v3": "^3.0",
        "pgvector/pgvector": "^0.2.2",
        "php-ffmpeg/php-ffmpeg": "^1.3",
        "platformcommunity/flysystem-bunnycdn": "*",
        "prism-php/prism": "^0.99.0",
        "resend/resend-php": "^0.18.1",
        "sentry/sentry-laravel": "^4.15",
        "socialiteproviders/microsoft": "^4.7",
        "spatie/crawler": "^8.4",
        "spatie/laravel-data": "^4.15",
        "spatie/laravel-login-link": "^1.6",
        "spatie/laravel-markdown": "^2.7",
        "spatie/laravel-pdf": "^1.6",
        "spatie/laravel-permission": "^6.23",
        "spatie/laravel-ray": "^1.40",
        "spatie/laravel-typescript-transformer": "^2.5",
        "symfony/browser-kit": "^7.3",
        "symfony/dom-crawler": "^7.3",
        "tightenco/ziggy": "^2.5",
        "yethee/tiktoken": "^0.10.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/boost": "^1.0",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.18",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.0",
        "spatie/laravel-horizon-watcher": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
        ],
        "dev:ssr": [
            "npm run build:ssr",
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"php artisan inertia:start-ssr\" --names=server,queue,logs,ssr"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
