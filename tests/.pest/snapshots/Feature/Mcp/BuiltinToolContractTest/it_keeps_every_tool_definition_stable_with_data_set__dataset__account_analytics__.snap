[
    {
        "name": "get-account-overview-tool",
        "title": "Get Account Overview Tool",
        "description": "A one-shot snapshot of the whole account for a period: total messages (incoming\n+ AI replies), conversations, unique visitors, leads captured, average response\ntime, thumbs up/down, tokens, and — when the account has a monthly message\nlimit — this month's messages used vs that limit. Use this first when the user asks \"how's my account doing?\" or wants\nan overview, then drill in with the more specific tools.",
        "inputSchema": {
            "properties": {
                "period": {
                    "description": "Time window. Defaults to \"this_month\". Use \"last_month\" for the one before, or a rolling window like \"last_7_days\"/\"last_30_days\".",
                    "default": "this_month",
                    "enum": [
                        "this_month",
                        "today",
                        "last_7_days",
                        "last_30_days",
                        "last_month",
                        "all_time"
                    ],
                    "type": "string"
                },
                "start_date": {
                    "description": "Optional explicit start date (YYYY-MM-DD). When given together with end_date it overrides `period`.",
                    "type": "string"
                },
                "end_date": {
                    "description": "Optional explicit end date (YYYY-MM-DD).",
                    "type": "string"
                },
                "agent": {
                    "description": "Optional agent id to narrow the numbers to a single agent. Omit for the whole account (all agents).",
                    "type": "string"
                }
            },
            "type": "object"
        },
        "annotations": {
            "readOnlyHint": true,
            "idempotentHint": true
        }
    },
    {
        "name": "get-message-stats-tool",
        "title": "Get Message Stats Tool",
        "description": "Message volume for a period: how many messages came in (from visitors) vs went\nout (AI replies), the combined total, the change vs the previous period, the\naverage messages per conversation, and a per-day series. Answers \"how many\nmessages this month?\", \"incoming vs outgoing?\", \"are we up or down vs last\nmonth?\". The per-day series is ideal to hand to a chart tool.",
        "inputSchema": {
            "properties": {
                "period": {
                    "description": "Time window. Defaults to \"this_month\". Use \"last_month\" for the one before, or a rolling window like \"last_7_days\"/\"last_30_days\".",
                    "default": "this_month",
                    "enum": [
                        "this_month",
                        "today",
                        "last_7_days",
                        "last_30_days",
                        "last_month",
                        "all_time"
                    ],
                    "type": "string"
                },
                "start_date": {
                    "description": "Optional explicit start date (YYYY-MM-DD). When given together with end_date it overrides `period`.",
                    "type": "string"
                },
                "end_date": {
                    "description": "Optional explicit end date (YYYY-MM-DD).",
                    "type": "string"
                },
                "agent": {
                    "description": "Optional agent id to narrow the numbers to a single agent. Omit for the whole account (all agents).",
                    "type": "string"
                }
            },
            "type": "object"
        },
        "annotations": {
            "readOnlyHint": true,
            "idempotentHint": true
        }
    },
    {
        "name": "get-conversation-stats-tool",
        "title": "Get Conversation Stats Tool",
        "description": "Conversation-level stats for a period: how many conversations started, the\naverage length (messages per conversation), the average duration in seconds, and\nthe single busiest day. Answers \"how many conversations this month?\", \"how long\nis the average chat?\", \"which day was busiest?\".",
        "inputSchema": {
            "properties": {
                "period": {
                    "description": "Time window. Defaults to \"this_month\". Use \"last_month\" for the one before, or a rolling window like \"last_7_days\"/\"last_30_days\".",
                    "default": "this_month",
                    "enum": [
                        "this_month",
                        "today",
                        "last_7_days",
                        "last_30_days",
                        "last_month",
                        "all_time"
                    ],
                    "type": "string"
                },
                "start_date": {
                    "description": "Optional explicit start date (YYYY-MM-DD). When given together with end_date it overrides `period`.",
                    "type": "string"
                },
                "end_date": {
                    "description": "Optional explicit end date (YYYY-MM-DD).",
                    "type": "string"
                },
                "agent": {
                    "description": "Optional agent id to narrow the numbers to a single agent. Omit for the whole account (all agents).",
                    "type": "string"
                }
            },
            "type": "object"
        },
        "annotations": {
            "readOnlyHint": true,
            "idempotentHint": true
        }
    },
    {
        "name": "get-top-users-tool",
        "title": "Get Top Users Tool",
        "description": "The most active end-users (identified chatters) for a period, ranked by how many\nmessages they sent, plus the count of unique identified users and how many new\nvisitors arrived. Answers \"who is my most active user?\", \"top 10 users by\nmessages\", \"how many unique / new visitors?\". Anonymous widget visitors with no\naccount are not individually named but are reflected in the new-visitor count.",
        "inputSchema": {
            "properties": {
                "period": {
                    "description": "Time window. Defaults to \"this_month\". Use \"last_month\" for the one before, or a rolling window like \"last_7_days\"/\"last_30_days\".",
                    "default": "this_month",
                    "enum": [
                        "this_month",
                        "today",
                        "last_7_days",
                        "last_30_days",
                        "last_month",
                        "all_time"
                    ],
                    "type": "string"
                },
                "start_date": {
                    "description": "Optional explicit start date (YYYY-MM-DD). When given together with end_date it overrides `period`.",
                    "type": "string"
                },
                "end_date": {
                    "description": "Optional explicit end date (YYYY-MM-DD).",
                    "type": "string"
                },
                "agent": {
                    "description": "Optional agent id to narrow the numbers to a single agent. Omit for the whole account (all agents).",
                    "type": "string"
                },
                "limit": {
                    "description": "How many top users to return (1–50). Defaults to 5.",
                    "default": 5,
                    "type": "integer"
                }
            },
            "type": "object"
        },
        "annotations": {
            "readOnlyHint": true,
            "idempotentHint": true
        }
    },
    {
        "name": "get-channel-breakdown-tool",
        "title": "Get Channel Breakdown Tool",
        "description": "Conversation volume per channel for a period — Hosted Chat, Chat Widget, Command\nBar, Telegram, Slack, WhatsApp, Messenger, MS Teams, Instagram — with each\nchannel's share of the total. Answers \"which channel is busiest?\", \"how much\ncomes from WhatsApp vs the website?\". The per-channel counts are ideal for a pie\nor bar chart. (Reflects retained conversations within the period.)",
        "inputSchema": {
            "properties": {
                "period": {
                    "description": "Time window. Defaults to \"this_month\". Use \"last_month\" for the one before, or a rolling window like \"last_7_days\"/\"last_30_days\".",
                    "default": "this_month",
                    "enum": [
                        "this_month",
                        "today",
                        "last_7_days",
                        "last_30_days",
                        "last_month",
                        "all_time"
                    ],
                    "type": "string"
                },
                "start_date": {
                    "description": "Optional explicit start date (YYYY-MM-DD). When given together with end_date it overrides `period`.",
                    "type": "string"
                },
                "end_date": {
                    "description": "Optional explicit end date (YYYY-MM-DD).",
                    "type": "string"
                },
                "agent": {
                    "description": "Optional agent id to narrow the numbers to a single agent. Omit for the whole account (all agents).",
                    "type": "string"
                }
            },
            "type": "object"
        },
        "annotations": {
            "readOnlyHint": true,
            "idempotentHint": true
        }
    },
