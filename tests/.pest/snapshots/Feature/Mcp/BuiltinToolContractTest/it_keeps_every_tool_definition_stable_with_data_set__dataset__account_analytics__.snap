                    "description": "Optional explicit start date (YYYY-MM-DD). When given together with end_date it overrides `period`.",
                    "type": "string"
                },
                "end_date": {
                    "description": "Optional explicit end date (YYYY-MM-DD).",
                    "type": "string"
                },
                "agent": {
                    "description": "Optional agent id to narrow the numbers to a single agent. Omit for the whole account (all agents).",
                    "type": "string"
                }
            },
            "type": "object"
        },
        "annotations": {
            "readOnlyHint": true,
            "idempotentHint": true
        }
    },
    {
        "name": "get-satisfaction-stats-tool",
        "title": "Get Satisfaction Stats Tool",
        "description": "Quality and satisfaction signals for a period: thumbs up vs down (and the\npositive rate), the sentiment split of messages (positive / neutral / negative),\nhow often the AI could not find an answer, and the average answer confidence.\nAnswers \"are people happy?\", \"how's sentiment?\", \"how often does the AI fail to\nanswer?\". Use this to spot knowledge gaps.",
        "inputSchema": {
            "properties": {
                "period": {
                    "description": "Time window. Defaults to \"this_month\". Use \"last_month\" for the one before, or a rolling window like \"last_7_days\"/\"last_30_days\".",
                    "default": "this_month",
                    "enum": [
                        "this_month",
                        "today",
                        "last_7_days",
                        "last_30_days",
                        "last_month",
                        "all_time"
                    ],
                    "type": "string"
                },
                "start_date": {
                    "description": "Optional explicit start date (YYYY-MM-DD). When given together with end_date it overrides `period`.",
                    "type": "string"
                },
                "end_date": {
                    "description": "Optional explicit end date (YYYY-MM-DD).",
                    "type": "string"
                },
                "agent": {
                    "description": "Optional agent id to narrow the numbers to a single agent. Omit for the whole account (all agents).",
                    "type": "string"
                }
            },
            "type": "object"
        },
        "annotations": {
            "readOnlyHint": true,
            "idempotentHint": true
        }
    },
    {
        "name": "get-response-time-stats-tool",
        "title": "Get Response Time Stats Tool",
        "description": "How fast the AI responds, for a period: the average reply time, the median (p50)\nand 95th-percentile (p95), the slowest reply, and the average time to the first\nreply in a conversation. All in milliseconds (first-response in seconds).\nAnswers \"how fast are replies?\", \"what's my p95 latency?\", \"how long until the\nfirst answer?\".",
        "inputSchema": {
            "properties": {
                "period": {
                    "description": "Time window. Defaults to \"this_month\". Use \"last_month\" for the one before, or a rolling window like \"last_7_days\"/\"last_30_days\".",
                    "default": "this_month",
                    "enum": [
                        "this_month",
                        "today",
                        "last_7_days",
                        "last_30_days",
                        "last_month",
                        "all_time"
                    ],
                    "type": "string"
                },
                "start_date": {
                    "description": "Optional explicit start date (YYYY-MM-DD). When given together with end_date it overrides `period`.",
                    "type": "string"
                },
                "end_date": {
                    "description": "Optional explicit end date (YYYY-MM-DD).",
                    "type": "string"
                },
                "agent": {
                    "description": "Optional agent id to narrow the numbers to a single agent. Omit for the whole account (all agents).",
                    "type": "string"
                }
            },
            "type": "object"
        },
        "annotations": {
            "readOnlyHint": true,
            "idempotentHint": true
        }
    },
    {
        "name": "get-top-topics-tool",
        "title": "Get Top Topics Tool",
        "description": "The topics visitors talk about most, for a period — each topic ranked by the\nnumber of conversations it appears in. Answers \"what are people asking about?\",\n\"top topics this month?\", \"what's trending?\". Great input for a bar chart of\ndemand by topic.",
        "inputSchema": {
            "properties": {
                "period": {
                    "description": "Time window. Defaults to \"this_month\". Use \"last_month\" for the one before, or a rolling window like \"last_7_days\"/\"last_30_days\".",
                    "default": "this_month",
                    "enum": [
                        "this_month",
                        "today",
