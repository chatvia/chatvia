# .dockerignore for ChatVia PostgreSQL Docker image

# Environment files
.env
.env.*

# Docker files
../docker-compose.yml
*.md
README*

# Nginx configs (not needed in postgres image)
*.conf

# Backup files
backups/
*.sql
*.dump

# Git
.git/
.gitignore

# IDE
.vscode/
.idea/

# Temporary files
*.log
*.tmp
tmp/
temp/

# Keep only essential files for the build
!Dockerfile
!init-db.sh
!init-extensions.sql
!postgresql.conf

