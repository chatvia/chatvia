# Settings for running the widget on its dev server (npm run dev) against a
# local Chatvia server. All optional: a build served by a Chatvia server needs
# none of them (see README.md, "Configuration"). Do not keep a .env here when
# you build the copy a Chatvia server serves (npm run shakomako:build).

VITE_SCRIPT_URL="http://localhost:3000/dist"
VITE_API_URL=http://localhost:8000/widget

# Live-agent handoff (Reverb). Without these, the widget uses the values the
# server sends.
VITE_REVERB_APP_KEY=your-reverb-app-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Release folder name. Without it: the package version plus a hash of the
# sources, so every changed build gets a new folder.
# VITE_APP_VERSION=1.0.0
