    {
        "name": "render-candlestick-chart-tool",
        "title": "Render Candlestick Chart Tool",
        "description": "Render an interactive candlestick (OHLC) chart for financial time-series.\nUse for stock prices, crypto, forex, or any time-bucketed open/high/low/close\ndata: \"Bitcoin daily closes for the last 2 years\", \"AAPL weekly OHLC for\nQ4\", \"EUR/USD hourly\".\n\nInputs:\n  - data: each entry is {date, open, high, low, close} — standard OHLC order.\n    The tool converts to ECharts's internal [open, close, low, high] order\n    for you, so don't worry about it.\n  - title / yAxisLabel: optional.\n  - showSlider: default true. The chart always supports wheel/pinch zoom; the\n    slider adds a visible drag handle below.\n\nUp candles (close ≥ open) render green; down candles render red. Built-in\nzoom + pan via dataZoom so 500+ point series stay readable.",
        "inputSchema": {
            "properties": {
                "data": {
                    "description": "Time-ordered OHLC candles. Use the standard {open, high, low, close} order — the tool handles ECharts's internal swap.",
                    "items": {
                        "properties": {
                            "date": {
                                "description": "Time bucket label, e.g. \"2024-01-15\" or \"Q1 2025\". Used as the x-axis category.",
                                "type": "string"
                            },
                            "open": {
                                "description": "Opening price.",
                                "type": "number"
                            },
                            "high": {
                                "description": "Highest price during the period.",
                                "type": "number"
                            },
                            "low": {
                                "description": "Lowest price during the period.",
                                "type": "number"
                            },
                            "close": {
                                "description": "Closing price.",
                                "type": "number"
                            }
                        },
                        "type": "object",
                        "required": [
                            "date",
                            "open",
                            "high",
                            "low",
                            "close"
                        ]
                    },
                    "type": "array"
                },
                "showSlider": {
                    "description": "Show the visible zoom slider below the chart. Default true. Set false for a cleaner look when the user wants the chart to stay fixed; mouse-wheel zoom still works either way.",
                    "default": true,
                    "type": "boolean"
                },
                "title": {
                    "description": "Optional chart title, e.g. \"BTC/USD Daily\".",
                    "type": "string"
                },
                "yAxisLabel": {
                    "description": "Optional y-axis label, e.g. \"Price (USD)\".",
                    "type": "string"
                },
                "summary": {
                    "description": "One sentence describing what the chart shows. The LLM sees this on follow-up turns; users see the chart, not this text.",
                    "type": "string"
                }
            },
            "type": "object",
            "required": [
                "data",
                "summary"
            ]
        },
        "annotations": {
            "readOnlyHint": true,
            "idempotentHint": true
        }
    }
